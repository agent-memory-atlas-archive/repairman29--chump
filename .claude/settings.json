{
  "model": "claude-haiku-4-5",
  "effortLevel": "medium",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/setup/session-start-session-id.sh\" ] && \"$REPO/scripts/setup/session-start-session-id.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/dev/ambient-emit.sh\" ] && \"$REPO/scripts/dev/ambient-emit.sh\" session_start 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/setup/session-start-urgent-inbox-poll.sh\" ] && \"$REPO/scripts/setup/session-start-urgent-inbox-poll.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_chump_tag": "resilient-256-git-guard",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v chump >/dev/null 2>&1 && exec chump git-guard --hook || exit 0"
          }
        ]
      },
      {
        "_chump_tag": "resilient-256-git-guard",
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v chump >/dev/null 2>&1 && exec chump git-guard --hook-write || exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/coord/ambient-context-inject.sh\" ] && \"$REPO/scripts/coord/ambient-context-inject.sh\" PreToolUse 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/coord/inbox-check-urgent.sh\" ] && \"$REPO/scripts/coord/inbox-check-urgent.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/dev/ambient-emit.sh\" ] && jq -r '.tool_input.file_path // .tool_input.path // \"\"' | { read -r f; [ -n \"$f\" ] && \"$REPO/scripts/dev/ambient-emit.sh\" file_edit \"path=$f\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/dev/ambient-emit.sh\" ] && jq -r '.tool_input.command // \"\"' | { read -r c; desc=\"${c:0:80}\"; [ -n \"$desc\" ] && \"$REPO/scripts/dev/ambient-emit.sh\" bash_call \"cmd=$desc\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$REPO/scripts/coord/inbox-poll.sh\" ] && \"$REPO/scripts/coord/inbox-poll.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
