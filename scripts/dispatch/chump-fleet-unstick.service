# ATC fleet-unstick runbook, deterministic. Keeps the selector source fresh +
# releases stale claims every shift so a ship-drought self-heals; escalates if not.
[Unit]
Description=ATC fleet-unstick — keep the fleet flowing (regen selector source, release stale claims, escalate if stuck)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; exec __REPO_ROOT__/scripts/ops/fleet-unstick.sh'
