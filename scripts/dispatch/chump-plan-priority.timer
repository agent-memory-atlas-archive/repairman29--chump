# chump-plan-priority.timer — INFRA-8143 30-minute cadence for chump-plan-priority.service.
# RESILIENT-1455: OnUnitInactiveSec alongside OnUnitActiveSec so oneshot timers self-perpetuate.

[Unit]
Description=Run Chump planner priority refresh every 30 minutes (INFRA-8143)

[Timer]
OnBootSec=2min
OnUnitActiveSec=30min
OnUnitInactiveSec=30min
AccuracySec=30s
Persistent=true
Unit=chump-plan-priority.service

[Install]
WantedBy=timers.target
