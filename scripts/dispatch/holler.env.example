# MISSION-111 — Example holler service configuration file
# Copy this to ~/.chump/holler.env and fill in the HOLLER_SERVICE_KEY
# The key can be obtained from your secret manager or external alert service

# The service key for holler alert emission
# This is loaded by holler-init.sh during service startup
HOLLER_SERVICE_KEY="your-service-key-here"

# Optional: alert endpoint URL if holler needs to POST alerts
# HOLLER_ALERT_ENDPOINT="https://alerts.example.com/v1/emit"

# Optional: log verbosity (info, debug, error)
# HOLLER_LOG_LEVEL="info"
