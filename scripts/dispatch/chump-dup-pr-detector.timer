# chump-dup-pr-detector.timer — INFRA-8144 15-minute cadence for chump-dup-pr-detector.service.
# RESILIENT-1455: OnUnitInactiveSec alongside OnUnitActiveSec so oneshot timers self-perpetuate.

[Unit]
Description=Run Chump duplicate-PR detector every 15 minutes (INFRA-8144)

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
OnUnitInactiveSec=15min
AccuracySec=30s
Persistent=true
Unit=chump-dup-pr-detector.service

[Install]
WantedBy=timers.target
