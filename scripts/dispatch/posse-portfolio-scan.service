[Unit]
Description=Posse portfolio discovery and autonomy scan
Documentation=https://github.com/repairman29/posse#portfolio-scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
StandardOutput=journal
StandardError=journal
# Load Posse environment and execute portfolio scan
ExecStart=/bin/bash -lc "set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; cd __HOME__/Projects/posse && npm run scan"
