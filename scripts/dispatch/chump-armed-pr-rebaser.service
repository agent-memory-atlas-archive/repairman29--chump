# chump-armed-pr-rebaser.service — INFRA-8144 Linux port of armed-pr-rebaser.
#
# Runs scripts/coord/armed-pr-rebaser.sh throttled to CHUMP_REBASER_MAX_PER_CYCLE=3
# so open ARMED (or DIRTY-unarmed fix-class) PRs whose mergeStateStatus is DIRTY
# or BEHIND rebase onto origin/main without storming CI all at once.
#
# Placeholders (__HOME__, __REPO_ROOT__) are substituted at install time by
# chump-node-install.sh place_role_unit_files / organ-unit-install-lib.sh.

[Unit]
Description=Chump armed-PR rebaser — throttled rebase of DIRTY/BEHIND PRs onto main (INFRA-8144)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=CHUMP_REBASER_MAX_PER_CYCLE=3
Environment=PATH=__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec bash __REPO_ROOT__/scripts/coord/armed-pr-rebaser.sh'
TimeoutStartSec=300
