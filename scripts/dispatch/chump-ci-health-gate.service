# Chump ci-health-gate tick — auto-pause the fleet when CI is jammed or an SLO breaches (ci-health-gate port)
# Ported from the macOS launchd agent (com.chump.ci-health-gate / launchd/com.chump.ci-health-gate.plist) to a host-agnostic systemd
# unit so the Linux fleet hub runs the complete organ roster (launchd->systemd
# port). Paths below are primary-node(root)-shaped and are host-rewritten per
# node by scripts/ops/lib/organ-unit-install-lib.sh (WorkingDirectory/ExecStart/
# HOME/User -> the repo-owning user + real HOME + real checkout path) when
# place_role_unit_files installs them — no hardcoded per-host path survives.
[Unit]
Description=Chump ci-health-gate tick — auto-pause the fleet when CI is jammed or an SLO breaches (ci-health-gate port)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
# Source providers.env (export-format creds) then exec the organ — same pattern
# as chump-pr-lander.service. Non-login shell so the host-rewriter's injected
# Environment=PATH (with the run-user's ~/.cargo/bin) stays authoritative.
ExecStart=/bin/bash -c 'set -a; source /root/.chump/providers.env 2>/dev/null; set +a; exec bash /root/Projects/chump/scripts/coord/ci-health-gate.sh'
TimeoutStartSec=300
