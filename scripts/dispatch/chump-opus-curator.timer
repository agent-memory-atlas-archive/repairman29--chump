# Run the Chump opus-curator tick every 10 minutes (curator port)
[Unit]
Description=Run the Chump opus-curator tick every 10 minutes (curator port)

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
