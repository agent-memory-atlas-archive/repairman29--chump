# chump-backlog-governor.service — INFRA-8175 autonomous backlog governor organ.
#
# Runs scripts/coord/backlog-governor.sh --apply to compute open gap counts by
# priority, 24h net burn (shipped_24h - filed_24h), detect wedges, heal expired
# .chump-locks leases / stale in_progress claims, and emit backlog_governor_tick.
#
# Placeholders (__HOME__, __REPO_ROOT__) are substituted at install time by
# chump-node-install.sh place_role_unit_files / organ-unit-install-lib.sh.

[Unit]
Description=Chump backlog governor — net-burn gauge + stale-lease wedge healer (INFRA-8175)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=PATH=__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec bash __REPO_ROOT__/scripts/coord/backlog-governor.sh --apply'
TimeoutStartSec=120
