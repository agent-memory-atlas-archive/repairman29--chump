# PRODUCT-382 — post-launch watch for the 2026-10-10 Facebook ask.
# Paired with chump-olive-fb-watch.timer (daily at 9am UTC for 14 days).
# Reports deltas in sign-ups, stores, cart pushes, and feedback to the board channel.
# Uses the Olive RPC endpoint to fetch metrics without copying keys off the node.
[Unit]
Description=Chump Olive post-launch watch — daily FB ask metrics report (PRODUCT-382)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Source providers.env for DISCORD_TOKEN + OLIVE_RPC_URL credentials.
# The script uses minted tokens (holler_drain_inbox pattern) for Olive access.
Environment=HOME=/root
ExecStart=/bin/bash -lc 'set -a; source /root/.chump/providers.env 2>/dev/null; set +a; exec /root/Projects/chump/scripts/overnight/olive-fb-watch.sh'
StandardOutput=journal
StandardError=journal
