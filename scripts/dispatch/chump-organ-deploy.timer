# scripts/dispatch/chump-organ-deploy.timer — RESILIENT-374. Drives
# chump-organ-deploy.service so the node's live systemd organ set converges to
# the repo-declared manifest AS ROOT on boot and every few minutes — the
# privileged half of self-deploy that chump-organ-reconcile/chump-organ-watchdog
# cannot perform on an owned node. This is the "a merged organ actually starts
# running" beat.
[Unit]
Description=Chump organ-deploy beat — root-privileged install+enable of every merged organ (RESILIENT-374)

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=10min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
