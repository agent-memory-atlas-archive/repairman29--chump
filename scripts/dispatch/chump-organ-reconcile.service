# RESILIENT-305 — reproducible-deploy slice 1. Converges helsinki's live systemd
# organ state to the repo-declared manifest (scripts/ops/organ-manifest.txt):
# enables the organs that must run and neuters the auto-pagers that must stay
# OFF. Paired with chump-organ-reconcile.timer. Deployed by
# scripts/setup/install-helsinki-atc.sh (system unit, root-owned). Runs the
# reconcile so drift between the repo and the node self-heals with no human step.
[Unit]
Description=Chump organ-reconcile — enforce repo-declared organ manifest (enabled organs up, auto-pagers OFF) (RESILIENT-305)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
# Source providers.env for parity with the other organs (export KEY=val format,
# so source it in a shell rather than a systemd EnvironmentFile).
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/ops/organ-reconcile.sh --apply'
