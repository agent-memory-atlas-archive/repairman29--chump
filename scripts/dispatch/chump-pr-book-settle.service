# Chump pr-book settle — scores the PR-book's P(merge) predictions against realized
# merge/close outcomes and REWRITES ~/.chump/pr-book-calibration.log (per-prediction
# {predicted,outcome} rows + a trailing brier summary) so the calibration_brier vital
# sign and the faculty know_score read an HONEST, fresh Brier every beat (paired with
# the .timer). Without this, the ledger records predictions but nothing ever scores
# them, and the sign reads UNKNOWN (the board could be lying and no one would know).
# Deployed by scripts/setup/install-helsinki-atc.sh, same as every other organ.
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
[Unit]
Description=Chump pr-book settle — score PR predictions vs outcomes, refresh Brier calibration
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; exec __REPO_ROOT__/scripts/coord/pr-book.sh --settle'
