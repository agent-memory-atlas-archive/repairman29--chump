# INFRA-3595 — self-heal watchdog for the ATC organ roster. No human restarts
# a failed chump-* organ: this unit scans for failed chump-*.service units
# (typically stuck `failed (Result: start-limit-hit)` after a oneshot fails a
# few times in a row) and enabled-but-inactive chump-*.timer units, then
# systemctl reset-failed + restart/start them. Emits organ_self_healed per
# unit healed.
#
# CHUMP_REPO_ROOT is REQUIRED: the script's default $HOME/Projects/Chump is
# capital-C and does not exist on case-sensitive Linux (see
# docs/process/LINUX_NODE_ONBOARDING.md).
#
# INFRA-8194 (Phase R R5): this is a PLACEHOLDER TEMPLATE, not a host-shaped
# unit. __HOME__ / __REPO_ROOT__ are resolved per host by the typed renderer
# (`chump node render-unit`, crates/chump-provision) or its shell mirror
# (organ_unit_host_rewrite in scripts/ops/lib/organ-unit-install-lib.sh, used by
# install-helsinki-atc.sh and chump-node-install.sh). There is deliberately NO
# User= line: the renderer injects User=<run-user> only for a system-scope
# install and never for a systemd --user manager (which cannot switch identity:
# 216/GROUP, 217/USER). scripts/ci/test-provision-no-host-literals.sh keeps
# every host literal (a concrete user, a home dir, the brew prefix) out of it.
#
# DO NOT use the systemd %h specifier here (INFRA-3647/TREK-21): for a
# SYSTEM-scope unit, %h is NOT influenced by User= and always resolves to the
# system manager's home (/root). On an owned node it ran the root path as the run user
# -> "Permission denied" (status 126). The renderer refuses %h for system scope.
[Unit]
Description=Chump organ watchdog — self-heal failed chump-* organs (INFRA-3595)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=CHUMP_ORGAN_WATCHDOG_CLONE_REFRESH=1
Environment=CHUMP_ORGAN_WATCHDOG_BINARY_HEAL=1
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/ops/organ-watchdog.sh'
