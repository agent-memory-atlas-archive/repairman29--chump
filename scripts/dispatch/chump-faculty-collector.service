# Chump faculty-collector — the DATA SOURCE for the OS self-portrait. Reads the
# 11 faculties' live endpoints and writes ~/.chump/faculty-status.json + a
# faculty_status ambient heartbeat every 15m (paired with the .timer). Deployed
# by scripts/setup/install-helsinki-atc.sh.
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
[Unit]
Description=Chump faculty-collector — writes faculty-status.json for the OS self-portrait
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/ops/faculty-collector.sh'
