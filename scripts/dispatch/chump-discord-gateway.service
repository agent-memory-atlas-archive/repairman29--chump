# RESILIENT-370 — serenity-free Discord RECEIVE gateway, tracked under
# scripts/dispatch/ so the manifest-derived ATC roster (install-helsinki-atc.sh,
# TREK-18) ACTUALLY deploys it. RESILIENT-266 shipped the gateway + a manifest
# `enabled chump-discord-gateway.service` line, but the unit template lived in
# scripts/ops/ where the roster never looks and the only installer was Mac
# launchd — so on every Linux node the organ was declared-but-never-installed,
# the exact drift class TREK-18 exists to kill. helsinki's decommission left the
# two-way operator channel dark with nothing to revive it.
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
# The beat also re-derives HOME from the run user at runtime.
[Unit]
Description=Chump Discord receive gateway (serenity-free, two-way operator channel) — RESILIENT-370
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=__HOME__
Environment=CHUMP_REPO=__REPO_ROOT__
WorkingDirectory=__REPO_ROOT__
# Source providers.env (export-format) for DISCORD_TOKEN + CHUMP_READY_DM_USER_ID
# — the SAME creds notify-operator.sh uses for the outbound half. The beat
# re-resolves and degrades gracefully (idles, never crash-loops) if absent.
# RESILIENT-1655: canonical portable template using __REPO_ROOT__ and __HOME__,
# launching __REPO_ROOT__/scripts/ops/discord-gateway.py via discord-gateway-beat.sh.
ExecStart=/bin/bash -c 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/dispatch/discord-gateway-beat.sh __REPO_ROOT__/scripts/ops/discord-gateway.py'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
