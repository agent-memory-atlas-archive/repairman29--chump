# RESILIENT-1190 — the trunk-recovery reviver organ. Runs
# scripts/coord/trunk-recovery-reviver.sh: on a trunk RECOVERY (RED→GREEN per the
# trunk-sentinel), reopens the PRs that were reaped as victims of the just-ended
# trunk-red window (closed in-window, reaper-marked, green-underneath now) and
# re-arms their auto-merge. The recovery counterpart to RESILIENT-1188 (which
# HOLDS PRs during trunk-red so no NEW victims are created); this reopens the
# ones legacy trunk-reds (and non-trunk-aware closers) already killed.
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
[Unit]
Description=Chump trunk-recovery reviver — reopen trunk-red victim PRs on recovery (RESILIENT-1190)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; cd __REPO_ROOT__; exec bash scripts/coord/trunk-recovery-reviver.sh'
