[Unit]
Description=Chump production back-pressure controller (halt/resume workers on jam)
[Service]
Type=oneshot
Environment=HOME=__HOME__
ExecStart=/bin/bash -lc "source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; cd __REPO_ROOT__; exec bash scripts/ops/back-pressure-controller.sh"
