# chump-branch-reaper.service — INFRA-8126 Linux port of the branch-reaper organ.
#
# Runs scripts/ops/stale-branch-reaper.sh --execute to delete remote branches
# that are >= 14 days stale with no open PR (plus orphan-branch cleanup).
#
# Placeholders (__HOME__, __REPO_ROOT__) are substituted at install time by
# chump-node-install.sh place_role_unit_files / organ-unit-install-lib.sh.

[Unit]
Description=Chump branch reaper — prune stale remote branches with no open PR (INFRA-8126)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=PATH=__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec bash __REPO_ROOT__/scripts/ops/stale-branch-reaper.sh --execute'
TimeoutStartSec=600
