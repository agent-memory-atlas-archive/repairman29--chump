# INFRA-375 / RESILIENT-306 — pairs with chump-ci-flake-rerun.service. Fires
# hourly (mirrors the retired launchd StartInterval=3600). Hourly is safe
# because every rerun is bounded: the per-run-id cooldown means a given failing
# run is only ever rerun once, and the per-PR flake budget stops a genuinely-
# failing PR from being thrashed. Enable: systemctl enable --now chump-ci-flake-rerun.timer
[Unit]
Description=Run the Chump CI flake auto-rerun hourly (INFRA-375)

[Timer]
OnBootSec=4min
OnUnitActiveSec=1h
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
