# INFRA-3601 — fires the board CEO-briefing beat on boot and every ~60 min on
# the primary node. Slower cadence than chump-board-cycle.timer (15 min,
# ops SLA layer) on purpose: strategic drift doesn't need a 15-minute pulse,
# but it must fire OOTB — on boot — so the briefing exists before a human
# ever opens a desktop session. Enable: systemctl enable --now
# chump-board-ceo-briefing.timer
[Unit]
Description=Run the Chump board CEO-briefing beat on boot + hourly (INFRA-3601)

[Timer]
OnBootSec=2min
OnUnitActiveSec=60min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=60min
Persistent=true

[Install]
WantedBy=timers.target
