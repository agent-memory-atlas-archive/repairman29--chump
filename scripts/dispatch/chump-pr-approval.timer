# RESILIENT-265 — fires the PR-approval surfacer every ~5 min on the primary
# node. The "baked into the OS" half: detection runs on a timer, not on an
# agent's memory, so an OS-authored product PR reaches Jeff's phone on its own.
# Enable: systemctl enable --now chump-pr-approval.timer
[Unit]
Description=Run the Chump PR-approval surfacer every 5 minutes (RESILIENT-265)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
