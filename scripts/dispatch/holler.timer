# MISSION-111 — timer for holler service. Fires the holler service periodically
# to check alert conditions and emit signals. Enable with:
#   systemctl enable --now holler.timer
[Unit]
Description=Timer for holler alert emission service (MISSION-111)

[Timer]
OnBootSec=30s
OnUnitActiveSec=5m
OnUnitInactiveSec=5m
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
