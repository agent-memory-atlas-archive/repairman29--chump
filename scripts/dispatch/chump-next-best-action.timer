# Pairs with chump-next-best-action.service. Recomputes the advisory
# next-best-action ranking every 20 minutes so the nervous system always reads
# a FRESH ~/.chump/next-best-action.json instead of the 8-day-stale file that
# motivated wiring this organ. Cheap (no LLM call), so a tight cadence is fine.
[Unit]
Description=Recompute the Chump next-best-action advisory ranking every 20 minutes (keep the NBA output fresh — nervous-system input)

[Timer]
OnBootSec=6min
OnUnitActiveSec=20min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=20min
Persistent=true

[Install]
WantedBy=timers.target
