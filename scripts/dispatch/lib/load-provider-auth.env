# scripts/dispatch/lib/load-provider-auth.env — CREDIBLE-1585 (PHASE-R)
#
# Targeted provider/organ credential loader for systemd units and organ wrappers.
# Replaces wholesale `set -a; source ~/.chump/providers.env; set +a` so
# non-allowlisted secrets (SUPABASE_SERVICE_ROLE_KEY, POSTGRES_PASSWORD, OCI_*,
# AWS_SECRET_ACCESS_KEY, STRIPE_*, CHUMP_SUBSTRATE_DB_PASSWORD, etc.) and bypass
# flags (CHUMP_*_SKIP, CHUMP_*_NO_*) are never exported into organ / headless
# agent environments.

_chump_load_provider_auth() {
    local _f _line _clean _k _v
    local _files=("$@")
    if [[ ${#_files[@]} -eq 0 ]]; then
        _files=("${HOME:-}/.chump/providers.env")
    fi
    for _f in "${_files[@]}"; do
        [[ -r "$_f" ]] || continue
        while IFS= read -r _line || [[ -n "$_line" ]]; do
            [[ "$_line" =~ ^[[:space:]]*$ || "$_line" =~ ^[[:space:]]*# ]] && continue
            _clean="$(printf '%s' "$_line" | sed -E 's/^[[:space:]]*export[[:space:]]+//; s/^[[:space:]]+//')"
            if [[ "$_clean" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
                _k="${BASH_REMATCH[1]}"
                _v="${BASH_REMATCH[2]}"
                _v="$(printf '%s' "$_v" | sed -E 's/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/')"
                # Explicitly deny database, cloud, billing, and service-role secrets
                # as well as test-gate / preflight bypass flags.
                case "$_k" in
                    SUPABASE_*|POSTGRES_*|OCI_*|AWS_*|STRIPE_*|*PASSWORD*|*SERVICE_ROLE*|*SECRET*|*_SKIP|*_NO_*|CHUMP_TEST_GATE)
                        continue
                        ;;
                esac
                case "$_k" in
                    ANTHROPIC_API_KEY|ANTHROPIC_DEFAULT_*|CLAUDE_CODE_OAUTH_TOKEN|OPENAI_API_KEY|OPENAI_API_BASE|OPENAI_MODEL|GEMINI_API_KEY|GOOGLE_API_KEY|OPENROUTER_API_KEY|GROQ_API_KEY|CEREBRAS_API_KEY|MISTRAL_API_KEY|DEEPSEEK_API_KEY|TOGETHER_API_KEY|FIREWORKS_API_KEY|SAMBANOVA_API_KEY|NVIDIA_API_KEY|HF_TOKEN|COHERE_API_KEY|GH_TOKEN|GITHUB_TOKEN|DISCORD_TOKEN|OLIVE_*|CHUMP_*)
                        export "${_k}=${_v}"
                        ;;
                esac
            fi
        done < "$_f"
    done
    unset SUPABASE_SERVICE_ROLE_KEY POSTGRES_PASSWORD AWS_SECRET_ACCESS_KEY STRIPE_SECRET_KEY CHUMP_SUBSTRATE_DB_PASSWORD
    local _oci_var
    while IFS='=' read -r _oci_var _; do
        case "$_oci_var" in
            OCI_*) unset "$_oci_var" 2>/dev/null || true ;;
        esac
    done < <(env)
}

_chump_load_provider_auth "$@"
unset -f _chump_load_provider_auth
