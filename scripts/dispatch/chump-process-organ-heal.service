# INFRA-3650 (PEER-HEAL-03) — heal loop for raw background bash procs that
# are NOT systemd units (e.g. almanac-vision-keeper). organ-watchdog.sh /
# organ-reconcile.sh already self-heal chump-*.service/.timer units; nothing
# revived an unsupervised bash proc started by hand. This unit runs one pass
# of scripts/ops/process-organ-heal.sh, which pgreps every entry in
# scripts/ops/process-organ-registry.txt and nohup-respawns anything missing
# (almanac-vision-keeper is the first registry entry).
#
# CHUMP_REPO_ROOT is REQUIRED, same reasoning as chump-organ-watchdog.service:
# the script's default $HOME/Projects/Chump is capital-C and does not exist on
# case-sensitive Linux (docs/process/LINUX_NODE_ONBOARDING.md).
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
# DO NOT use the systemd %h specifier (INFRA-3647/TREK-21): on a SYSTEM-scope
# unit %h ignores User= and always resolves to the root home, so on an owned
# node it exec'd root's checkout as the run user ("Permission denied"). The
# renderer refuses %h at system scope.
[Unit]
Description=Chump process-organ heal loop — revive unsupervised bash procs (INFRA-3650)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/ops/process-organ-heal.sh'
