# RESILIENT-1098 — apex watchdog-of-the-watchdog. Cross-node peer heartbeat
# check: this unit watches OTHER fleet nodes (docs/fleet/nodes/*.json), not
# this one. It exists so a whole-node wedge (organ-watchdog dead,
# organ-reconcile dead, systemd itself hosed) is still caught — by a peer
# node, not by the operator session. Every fleet node runs this same unit,
# each watching its peers, so there is no single point of observation.
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
[Unit]
Description=Chump apex watchdog — cross-node peer heartbeat check (RESILIENT-1098)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/ops/apex-watchdog.sh'
