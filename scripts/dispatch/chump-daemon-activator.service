# chump-daemon-activator.service — INFRA-8146 Linux port of daemon-activator-launchd
# (scripts/setup/install-daemon-activator.sh / bootstrap-manifest.yaml).
#
# Runs scripts/coord/daemon-activator-loop.sh to detect newly merged organ/daemon
# installers since the last checkpoint and activate/reconcile them automatically.
#
# Placeholders (__HOME__, __REPO_ROOT__) are substituted at install time by
# chump-node-install.sh place_role_unit_files / organ-unit-install-lib.sh.

[Unit]
Description=Chump daemon activator — auto-load newly merged daemon installers (INFRA-8146)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=PATH=__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec bash __REPO_ROOT__/scripts/coord/daemon-activator-loop.sh'
TimeoutStartSec=300
