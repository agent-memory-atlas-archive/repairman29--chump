# INFRA-303 / drift-fix — periodic GitHub-truth gap-closure reconciler.
# Runs gap-doctor-reconcile.py in THREE complementary modes each tick:
#   --check-closure-drift     : gaps still `open` whose closed_pr PR has MERGED
#                               on GitHub → close (status=done + closed_pr).
#   --check-merged-pr-links   : gaps still `open` with NO closed_pr that a typed
#                               gap_prs row links to a MERGED PR →
#                               close (status=done + closed_pr + closed_date)
#                               from GitHub truth. CREDIBLE-1550 (Phase R R2)
#                               replaced the former PR-TITLE match with the
#                               gap_prs FK as the ONLY proof — a title falsely
#                               closed CREDIBLE-1492 (docs PR) and CREDIBLE-1520
#                               (AC1-only slice). This is the async-merge ghost
#                               class the other two passes miss — real work
#                               shipped, PR merged after the worker cycle ended,
#                               canonical state.db left open.
#   --check-already-satisfied : gaps still `open` with NO closed_pr whose latest
#                               worker cycle log shows the work already shipped in
#                               a merged PR → close already_satisfied (INFRA-3826).
#                               Low-confidence matches are FLAGGED, never closed.
# Together they are the durable backstop for the fragile bot-merge auto-close
# (CREDIBLE-295, which silently skips and leaves OPEN-BUT-LANDED ghosts) AND the
# live-only INFRA-3808 worker close (which misses gaps whose cycle it wasn't
# watching). Without this organ the gap store drifts from GitHub reality
# permanently: covered gaps sit `open` and get re-picked forever (found
# 2026-08-21: this timer went dead; re-armed under INFRA-3826).
#
# NODE-AGNOSTIC (EFFECTIVE-1543): repo root is resolved at runtime from
# $CHUMP_REPO_ROOT, then $HOME/chump, then $HOME/Projects/chump — do NOT
# hardcode a node's path here (the old /root/Projects/chump made this unit a
# no-op on every non-helsinki node, so it was never even installed on cuphead).
[Unit]
Description=Chump gap-closure reconciler — close open-but-merged, merged-PR-title & already-satisfied gaps from GitHub truth (INFRA-303 / INFRA-3826 / EFFECTIVE-1543)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
# The drift pass exits 3 when it FINDS+resolves drift (an alert contract for the
# CI/cron callers), and merged-pr-titles/already-satisfied exit 0 on any clean
# run. For this self-healing oneshot every clean outcome must leave the unit
# green, so the first two passes swallow their rc (|| true) and the
# already-satisfied pass sets the service's exit code.
ExecStart=/bin/bash -lc 'REPO="${CHUMP_REPO_ROOT:-}"; for c in "$REPO" "$HOME/chump" "$HOME/Projects/chump"; do if [ -n "$c" ] && [ -d "$c/.git" ]; then REPO="$c"; break; fi; done; [ -d "$REPO/.git" ] || { echo "gap-closure-reconcile: no chump repo found (CHUMP_REPO_ROOT/$HOME/chump/$HOME/Projects/chump)" >&2; exit 1; }; cd "$REPO"; [ -f "$REPO/scripts/dispatch/lib/load-provider-auth.env" ] && . "$REPO/scripts/dispatch/lib/load-provider-auth.env" "$HOME/.chump/providers.env" 2>/dev/null; python3 scripts/coord/gap-doctor-reconcile.py --check-closure-drift || true; python3 scripts/coord/gap-doctor-reconcile.py --check-merged-pr-links || true; exec python3 scripts/coord/gap-doctor-reconcile.py --check-already-satisfied'
TimeoutStartSec=300
