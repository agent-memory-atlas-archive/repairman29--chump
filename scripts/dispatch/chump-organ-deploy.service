# scripts/dispatch/chump-organ-deploy.service — RESILIENT-374 (anti-merged-not-
# running). The root-privileged self-deploy organ. On owned nodes (CJ=jeff),
# chump-organ-reconcile and chump-organ-watchdog run as the repo-owning user and
# CANNOT write /etc/systemd/system, so every merged chump-*.service/.timer stayed
# DARK (declared `enabled` in the manifest, never installed in systemd) — the
# exact merged-not-running disease. This organ runs install-helsinki-atc.sh
# --auto AS ROOT (install + enable --now + reconcile) so a merged organ actually
# RUNS on the target. Paired with chump-organ-deploy.timer.
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE (__HOME__ / __REPO_ROOT__,
# rendered per host by `chump node render-unit` or organ_unit_host_rewrite).
# UNLIKE every other organ it must run as root (its whole job is the privileged
# system-unit write). That is declared by NAME, not by a baked User= line: it is
# in install-helsinki-atc.sh's _KEEP_ROOT_ORGANS, chump-node-install.sh's
# _KEEP_ROOT and chump_provision::KEEP_ROOT_UNITS, so both renderers write
# User=root for it at system scope while its paths still resolve to the run
# user's home. The manifest tags its timer run-scope=system.
[Unit]
Description=Chump organ-deploy — root-privileged self-deploy: install+enable+reconcile every merged organ so merged==running (RESILIENT-374)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
Environment=CARGO_BIN_DIR=__HOME__/.cargo/bin
ExecStart=/bin/bash -lc 'exec __REPO_ROOT__/scripts/ops/organ-deploy.sh'
