# INFRA-3593 — tracks the merge-SLA scorecard unit live-hacked onto helsinki on
# 2026-08-11 alongside chump-armed-rebaser and chump-node-refresh. Runs
# scripts/coord/merge-sla-scorecard.sh --apply: flags PRs open past the
# CHUMP_SLA_BREACH_MINUTES ratchet (default 60m, tightening toward 30m as
# p90 falls — INFRA-3592) unmerged with no owner as a board BREACH and pages
# the operator (RESILIENT-302).
#
# CHUMP_REPO_ROOT is REQUIRED: the script's default $HOME/Projects/Chump is
# capital-C and does not exist on case-sensitive Linux (see
# docs/process/LINUX_NODE_ONBOARDING.md).
#
# WorkingDirectory is REQUIRED (INFRA-3598): merge-sla-scorecard.sh resolves
# the target repo via `gh repo view` (cwd-based nameWithOwner detection), not
# CHUMP_REPO_ROOT. Without it systemd's default cwd (/) makes `gh repo view`
# return empty and the unit fails every cycle with "no repo nwo; skip" — the
# live FAILED state this gap's proof step found on helsinki, independent of
# the already-merged INFRA-3592 ratchet fix.
[Unit]
Description=Chump merge-SLA scorecard — flag PRs open past the SLA ratchet unmerged with no owner (RESILIENT-302)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
WorkingDirectory=__REPO_ROOT__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; exec __REPO_ROOT__/scripts/coord/merge-sla-scorecard.sh --apply'
