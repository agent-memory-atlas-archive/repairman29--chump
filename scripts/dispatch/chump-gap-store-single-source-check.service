# RESILIENT-1058 — wires scripts/coord/gap-store-single-source-check.sh
# (RESILIENT-1057) into a scheduled organ instead of a script only ever run
# by hand. Paired with chump-gap-store-single-source-check.timer.
#
# The check exits non-zero on ANY detected split-brain (CLI/sqlite disagree,
# or a non-empty postgrest store diverging from state.db). A non-zero exit
# here fails the unit — organ-watchdog's reset-failed+restart heal loop and
# the duty officer's health scan both already watch for failed units, so
# this organ needs no bespoke paging path to become visible.
#
# CHUMP_REPO_ROOT / HOME are set explicitly, same reasoning as every other
# root-owned organ unit here (script's default $HOME/Projects/Chump is
# capital-C and does not exist on case-sensitive Linux —
# docs/process/LINUX_NODE_ONBOARDING.md).
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
[Unit]
Description=Chump gap-store single-source-of-truth check (RESILIENT-1058 / RESILIENT-1057)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=CHUMP_REPO_ROOT=__REPO_ROOT__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; exec __REPO_ROOT__/scripts/coord/gap-store-single-source-check.sh'
