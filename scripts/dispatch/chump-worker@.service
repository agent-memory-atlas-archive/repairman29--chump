[Unit]
Description=Chump headless fleet worker %i (RESILIENT-283 / INFRA-8639)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=-__HOME__/.chump/node.env
ExecStart=/bin/bash __REPO_ROOT__/scripts/dispatch/node-worker-run.sh %i
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
