# INFRA-3654 (PEER-VERI-07) — pairs with chump-outcome-verify-heal-consumer.service.
# 10-minute cadence: a failed live-verification claim is exactly the kind of
# signal that should not sit unpaged for an hour — tighter than the 5min
# process-organ-heal.sh cadence would be overkill (this consumer's own work
# is a cheap ambient-log tail), looser than 1min avoids needless churn.
[Unit]
Description=Run the Chump outcome-verify heal consumer every 10 minutes (INFRA-3654)

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
