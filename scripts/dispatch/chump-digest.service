# RESILIENT-376 — the DISCORD DIGEST organ: a short, phone-readable digest of
# the factory (SHIPPED / THE NUMBER / STUCK / NEEDS-YOUR-CALL) pushed to Jeff's
# Discord DM twice a day, so a multi-day operating model needs no terminal
# babysitting. Deterministic state-read only — NO LLM, no tokens. Distinct from
# chump-board-ceo-briefing.service (the Sonnet STRATEGY layer); this is the
# cheap HUMAN-INTERFACE pulse. Paired with chump-digest.timer.
#
# INFRA-8194 (Phase R R5): placeholder TEMPLATE. __HOME__ / __REPO_ROOT__ are
# resolved per host by `chump node render-unit` (crates/chump-provision) or its
# shell mirror organ_unit_host_rewrite (install-helsinki-atc.sh,
# chump-node-install.sh). No User= line: the renderer injects User=<run-user>
# for a system-scope install only, never for a --user manager (217/USER).
# Creds come from __HOME__/.chump/providers.env.
[Unit]
Description=Chump Discord digest — twice-daily phone-readable factory pulse to the operator (RESILIENT-376)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
# Source providers.env for DISCORD_TOKEN + CHUMP_READY_DM_USER_ID (export
# format, so source it in a shell rather than systemd EnvironmentFile).
ExecStart=/bin/bash -lc 'source __REPO_ROOT__/scripts/dispatch/lib/load-provider-auth.env __HOME__/.chump/providers.env 2>/dev/null; exec __REPO_ROOT__/scripts/dispatch/digest-beat.sh'
