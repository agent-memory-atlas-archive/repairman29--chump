# INFRA-3650 (PEER-HEAL-03) — pairs with chump-process-organ-heal.service.
# 5-minute cadence matches process-organ-heal.sh's own default respawn-loop
# interval (CHUMP_PROCESS_ORGAN_HEAL_INTERVAL_S=300), so a dead
# almanac-vision-keeper is caught within one cycle either way it's driven.
[Unit]
Description=Run the Chump process-organ heal loop every 5 minutes (INFRA-3650)

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
# RESILIENT-1455: OnUnitInactiveSec pairs with OnUnitActiveSec so this Type=oneshot
# timer self-perpetuates. A oneshot goes inactive after each run, leaving OnUnitActiveSec
# with no live "active" anchor -> NextElapse goes n/a and the timer fires once, never again.
# OnUnitInactiveSec re-arms from the inactive edge (the anchor a oneshot has). Mirrors the
# chump-farmer.timer fix (#4808 / RESILIENT-313).
OnUnitInactiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
