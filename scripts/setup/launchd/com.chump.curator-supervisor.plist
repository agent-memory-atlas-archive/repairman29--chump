<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.chump.curator-supervisor.plist — INFRA-2239
  Launchd user agent that runs chump-curator-supervisor every 300 seconds.

  The supervisor checks the 6 productized curators (shepherd/target/handoff/
  ci-audit/decompose/md-links) for silent failures, files gaps, optionally
  spawns a Sonnet sub-agent, and optionally restarts the failing tmux pane.

  Install:   scripts/setup/install-curator-supervisor.sh
  Uninstall: scripts/setup/install-curator-supervisor.sh (uninstall flag)
             The flag is spelled out because a literal double-hyphen is
             illegal inside an XML comment: CoreFoundation and plutil
             tolerate it, but strict parsers (python plistlib) reject the
             whole file, which blocked plist validation in tests.
  Status:    launchctl print gui/$(id -u)/com.chump.curator-supervisor
  Logs:      ~/Library/Logs/Chump/curator-supervisor.out.log
             ~/Library/Logs/Chump/curator-supervisor.err.log

  Tunable env vars (see crates/chump-curator-supervisor/src/main.rs for full list):
    CHUMP_CURATOR_SUPERVISOR_MODE         (default aggressive)
    CHUMP_CURATOR_SUPERVISOR_AUTORESTART  (default 1)
    CHUMP_CURATOR_SUPERVISOR_DRY_RUN      (default unset)
    CHUMP_CURATOR_HEARTBEAT_STALL_M       (default 10)
    RUST_LOG                              (default info)

  RESILIENT-246 (2026-08-09) — WHY ProgramArguments IS /bin/bash + A SCRIPT:

  This plist used to put the release BINARY directly in ProgramArguments:
      <string>/Users/.../Chump/target/release/chump-curator-supervisor</string>
  target/release is disposable (cargo clean, cargo-target-reaper, disk-pressure
  reaps). When that binary vanished ~2026-08-01, launchd could not spawn the
  job and returned exit status 78 (EX_CONFIG) every StartInterval for twelve
  days. Because launchd fails BEFORE the process exists, it never opened
  StandardOutPath/StandardErrorPath — both logs stayed byte-for-byte silent.
  There was no error to find; the logs just stopped. Nothing alerted.

  Now ProgramArguments is /bin/bash (which always exists) running a
  version-controlled script, exactly like dev.chump.reaper-watchdog. launchd
  can always spawn it, so a missing binary is now a loud ALERT from a running
  process instead of a silent pre-spawn 78. The runner also stamps a heartbeat
  that the existing reaper-heartbeat-watchdog grades.

  Do NOT "simplify" this back to a direct binary path. That is the bug.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chump.curator-supervisor</string>

    <!-- Run every 300 seconds (StartInterval, not KeepAlive). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Run once immediately on load. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- RESILIENT-246: /bin/bash + repo script, never a target/ build artifact. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>CHUMP_REPO_ROOT_PLACEHOLDER/scripts/ops/curator-supervisor-run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>CHUMP_REPO_ROOT_PLACEHOLDER</string>

    <!-- Environment — repo root substituted at install time. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:__BREW_PREFIX__/bin:CHUMP_HOME_PLACEHOLDER/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>CHUMP_HOME_PLACEHOLDER</string>
        <key>CHUMP_REPO_ROOT</key>
        <string>CHUMP_REPO_ROOT_PLACEHOLDER</string>
        <key>CHUMP_CURATOR_SUPERVISOR_MODE</key>
        <string>aggressive</string>
        <key>CHUMP_CURATOR_SUPERVISOR_AUTORESTART</key>
        <string>1</string>
        <key>CHUMP_CURATOR_HEARTBEAT_STALL_M</key>
        <string>10</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>CHUMP_LOG_DIR_PLACEHOLDER/curator-supervisor.out.log</string>
    <key>StandardErrorPath</key>
    <string>CHUMP_LOG_DIR_PLACEHOLDER/curator-supervisor.err.log</string>
</dict>
</plist>
