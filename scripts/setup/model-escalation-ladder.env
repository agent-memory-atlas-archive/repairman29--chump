# Tracked floor-model / escalation-ladder manifest (RESILIENT-1009, a
# DEPRECATED (RESILIENT-600): superseded by scripts/setup/floor-config.json, which is loaded after this file and wins. Kept only as a fallback when jq is absent.
# RESILIENT-596 slice).
#
# Canonical, committed home for CHUMP_FLOOR_MODEL / CHUMP_MODEL_ESCALATION_LADDER
# / CHUMP_FREE_TIER_PROVIDERS — the cost-tiered model routing config described
# in docs/strategy/MODEL_ROUTING_LADDER_2026-07-22.md. Before this file existed
# these values lived only in machine-local, gitignored files
# (~/.chump/providers.env, per-node chumpd.env) that a fresh node install or a
# hand-edit on one box could silently drift from the fleet's intended ladder —
# exactly the class of bug EFFECTIVE-445 found live (Pixel stalled on a stale
# unfunded ladder for days because its local file never got the fix that
# shipped to CJ). Mirrors the CREDIBLE-185 pattern used by
# scripts/setup/provider-model-classes.env.
#
# Consumers `source` this file directly (values are plain KEY=VALUE, no
# quoting needed). scripts/dispatch/worker.sh sources it LAST, after any
# inherited ~/.chump/providers.env or launcher-set env, so this manifest's
# values always win for the ladder itself (RESILIENT-1009 AC2) —
# providers.env's job is narrowed to supplying SECRET VALUES only (API keys,
# OAuth tokens), never the ladder shape.
#
# API key VALUES are never stored here — only the env-var NAMES the ladder
# references via the existing "<model>@<base-url>:<KEY_ENV_NAME>" suffix
# convention (see CHUMP_FREE_TIER_PROVIDERS below). The named vars
# (OPENROUTER_API_KEY, GROQ_API_KEY) must still be supplied out-of-band via
# ~/.chump/providers.env or the environment, per RESILIENT-173 (no secrets in
# git).
#
# To change the fleet's floor model or escalation ladder, edit THIS file and
# ship the PR — do not hand-edit the ladder on a node's local providers.env,
# it will drift on the next fresh install / re-provision.

# EFFECTIVE-445: DeepSeek V4 primary, funded via OpenRouter. Free front-slots
# first (spend $0), then paid DeepSeek as the on-429 failover.
CHUMP_FLOOR_MODEL=deepseek/deepseek-v4-flash

# Cheapest-first, comma-separated. Bare model IDs only — no "@base:KEY"
# suffix (worker.sh borrows the suffix from the first CHUMP_FREE_TIER_PROVIDERS
# entry, which must point at OpenRouter for these rungs to route correctly).
CHUMP_MODEL_ESCALATION_LADDER=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro

# "<model>@<base-url>:<KEY_ENV_NAME>" per entry, cheapest/free first.
CHUMP_FREE_TIER_PROVIDERS=nvidia/nemotron-3-super-120b-a12b:free@https://openrouter.ai/api/v1:OPENROUTER_API_KEY,openai/gpt-oss-20b@https://api.groq.com/openai/v1:GROQ_API_KEY,deepseek/deepseek-v4-flash@https://openrouter.ai/api/v1:OPENROUTER_API_KEY,deepseek/deepseek-v4-pro@https://openrouter.ai/api/v1:OPENROUTER_API_KEY

# DeepSeek V4 are reasoning models; a low cap burns the whole budget on
# reasoning_tokens and returns empty content (EFFECTIVE-445).
CHUMP_COMPLETION_MAX_TOKENS=8192

# == ladder length so decompose never cuts the open ladder short (EFFECTIVE-314).
CHUMP_DECOMPOSE_STRIKE_THRESHOLD=2
