# Tracked provider -> model-class manifest (CREDIBLE-185).
#
# Canonical, committed home for the opus/sonnet/haiku routing tags that
# scripts/setup/apply-mabel-badass-env.sh (and any other .env generator)
# writes into CHUMP_PROVIDER_<N>_MODEL_CLASS. Before this file existed those
# tags lived only inside gitignored, per-machine .env files — a fresh
# checkout (or a re-run of apply-mabel-badass-env.sh, which rewrites the
# cascade block from scratch) had no source of truth for which class each
# cloud provider slot should be tagged as, so the tags silently dropped or
# drifted machine-to-machine. This file is checked into git; consumers
# `source` it and look up `PROVIDER_MODEL_CLASS_<name>`.
#
# NOTE: keys must be valid bash identifiers (hyphens in provider names
# become underscores, e.g. "gemini-pro" -> PROVIDER_MODEL_CLASS_gemini_pro),
# since this file is sourced directly by bash.
#
# Format: PROVIDER_MODEL_CLASS_<provider_name>=<opus|sonnet|haiku>
# <provider_name> matches CHUMP_PROVIDER_N_NAME in .env.example (hyphens -> underscores).
# Class meaning (matches CHUMP_PREFERRED_MODEL_CLASS in provider_cascade.rs):
#   opus   - highest-quality tier, used when CHUMP_PREFERRED_MODEL_CLASS=opus
#   sonnet - default/mid tier (most free 70B-class cloud providers land here)
#   haiku  - cheapest/fastest tier

PROVIDER_MODEL_CLASS_gemini=sonnet
PROVIDER_MODEL_CLASS_gemini_pro=opus
PROVIDER_MODEL_CLASS_gemini_flash=sonnet
PROVIDER_MODEL_CLASS_gemini_flash_lite=haiku
PROVIDER_MODEL_CLASS_groq=sonnet
PROVIDER_MODEL_CLASS_cerebras=sonnet
PROVIDER_MODEL_CLASS_mistral=sonnet
PROVIDER_MODEL_CLASS_mistral_codestral=opus
PROVIDER_MODEL_CLASS_openrouter=sonnet
PROVIDER_MODEL_CLASS_github=haiku
PROVIDER_MODEL_CLASS_nvidia=sonnet
PROVIDER_MODEL_CLASS_sambanova=sonnet
PROVIDER_MODEL_CLASS_xai=sonnet
PROVIDER_MODEL_CLASS_scaleway=haiku
