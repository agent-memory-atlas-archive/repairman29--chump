[Unit]
Description=Chump load-aware node dead-man timer (RESILIENT-1611)
Documentation=https://github.com/repairman29/chump/blob/main/scripts/ops/load-aware-deadman.sh

[Timer]
# Check every 60 seconds for load/memory/ssh issues
OnBootSec=30s
OnUnitActiveSec=60s
# Spread timer across the minute to avoid thundering herd
RandomizedDelaySec=10s
Persistent=true

[Install]
WantedBy=timers.target
