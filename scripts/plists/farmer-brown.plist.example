<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.chump.farmer-brown</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__REPO_ROOT__/scripts/dev/farmer-brown.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <!-- Farmer Brown: diagnose + fix (kill stale, then keep-chump-online). Placeholders (__REPO_ROOT__, __HOME__, __BREW_PREFIX__) are filled per host by scripts/setup/install-roles-launchd.sh (chump node render-unit, INFRA-8194). Load .env from WorkingDirectory. -->
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/logs/farmer-brown-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/logs/farmer-brown-launchd.err.log</string>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:__BREW_PREFIX__/bin:__HOME__/.local/bin</string>
  </dict>
</dict>
</plist>
