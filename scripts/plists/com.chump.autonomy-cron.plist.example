<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chump.autonomy-cron</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__REPO_ROOT__/scripts/dev/autonomy-cron.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>RunAtLoad</key>
  <false/>
  <!-- Run every hour. Reaps expired leases then attempts one autonomy task. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/logs/autonomy-cron.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/logs/autonomy-cron.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:__BREW_PREFIX__/bin:__HOME__/.local/bin:__HOME__/.cargo/bin</string>
  </dict>
</dict>
</plist>
