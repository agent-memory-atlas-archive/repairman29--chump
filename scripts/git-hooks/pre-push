import json, os, sys
from datetime import datetime, timezone
lock_dir = sys.argv[1]
gap_ids = set(sys.argv[2:])
now = datetime.now(timezone.utc)
for fname in os.listdir(lock_dir):
    if not fname.endswith(".json"):
        continue
    try:
        d = json.load(open(os.path.join(lock_dir, fname)))
    except Exception:
        continue
    if d.get("gap_id") not in gap_ids:
        continue
    try:
        exp = datetime.fromisoformat(d.get("expires_at", "").rstrip("Z")).replace(tzinfo=timezone.utc)
        if (exp - now).total_seconds() <= 0:
            continue  # expired
    except Exception:
        continue
    sid = d.get("session_id", "")
    if sid:
        print(sid)
        break
PYEOF
)"
    fi

    # shellcheck disable=SC2086
    if ! CHUMP_SESSION_ID="${_OWN_SESSION:-}" "$PREFLIGHT" $GAP_IDS; then
        # If we detected a session that matches this push, surface that as a
        # false positive and emit an ambient event for observability (INFRA-1165).
        if [[ -n "$_OWN_SESSION" ]]; then
            echo "[pre-push] WARN: gap-preflight rejected push despite matching lease '$_OWN_SESSION'." >&2
            echo "[pre-push]   This may be a gap-preflight bug — consider filing a follow-up gap." >&2
            _AMBIENT_EMIT="$REPO_ROOT/scripts/dev/ambient-emit.sh"
            if [[ -x "$_AMBIENT_EMIT" ]]; then
                "$_AMBIENT_EMIT" gap_check_false_positive \
                    "gap_ids=$(echo "$GAP_IDS" | tr '\n' ',')" \
                    "session=$_OWN_SESSION" 2>/dev/null || true
            fi
        fi
        echo "[pre-push] Push blocked: one or more gaps already done or claimed." >&2
        echo "[pre-push] This branch's work may already be on main." >&2
        echo "[pre-push] Run: git show origin/main:docs/gaps.yaml | grep -A8 'id: GAP-XYZ'" >&2
        echo "[pre-push] Bypass (when commit bodies cause false positives): CHUMP_GAP_CHECK=0 git push" >&2
        exit 1
    fi
done <<<"$_HOOK_STDIN"

# ── INFRA-1421: CI-regression-guard suite ─────────────────────────────────────
# When a push touches ci.yml fix commits, verify CI-Regression-Guard trailers
# reference existing tests, then run those tests to catch re-regressions early.
# Use git rev-parse to locate the guard script; degrade gracefully when git
# cannot resolve a work-tree (bare clones used in test harnesses).
_CI_REG_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_CI_REG_GUARD="${_CI_REG_ROOT:+$_CI_REG_ROOT/scripts/git-hooks/pre-push-ci-regression-guard.sh}"
if [[ -n "$_CI_REG_GUARD" ]] && [[ -x "$_CI_REG_GUARD" ]] && [[ "${CHUMP_CI_REGRESSION_GUARD:-1}" != "0" ]]; then
    # Redirect stdout → stderr so test harnesses that capture hook stdout
    # to extract the exit code are not polluted by guard diagnostic output.
    if ! bash "$_CI_REG_GUARD" >&2; then
        echo "[pre-push] CI regression guard failed — push blocked." >&2
        echo "[pre-push] Bypass (sparingly): CHUMP_CI_REGRESSION_GUARD=0 git push" >&2
        exit 1
    fi
fi

# ── INFRA-2322: actionlint pre-push gate ──────────────────────────────────────
# When a push touches .github/workflows/*.yml, run actionlint locally (if
# installed) to catch the matrix-in-if and version-typo classes before CI
# round-trip. Skips gracefully (non-blocking) when the binary is absent.
_ACTIONLINT_GUARD="${_CI_REG_ROOT:+$_CI_REG_ROOT/scripts/git-hooks/pre-push-actionlint-guard.sh}"
if [[ -n "$_ACTIONLINT_GUARD" ]] && [[ -x "$_ACTIONLINT_GUARD" ]] && [[ "${CHUMP_ACTIONLINT_GUARD:-1}" != "0" ]]; then
    if ! bash "$_ACTIONLINT_GUARD" >&2; then
        echo "[pre-push] actionlint guard failed — push blocked." >&2
        echo "[pre-push] Bypass (rare): CHUMP_ACTIONLINT_GUARD=0 git push" >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------
# Guard 5: Branch-name claim contract (RESILIENT-026, 2026-05-27)
#
# When a .chump-locks/claim-*.json exists with a gap_id, the current
# branch name MUST be chump/<gap-id>-claim (case-insensitive compare).
# Prevents "pushed my work on the wrong branch" — an off-rails push
# pattern complementary to RESILIENT-025/026 pre-commit guards.
#
# Multi-session fix (INFRA-2446, 2026-06-03): when multiple claim files
# are present (parallel sessions), enumerate ALL and find the one whose
# gap_id matches the current branch (chump/<gap-id>-claim). Prefer the
# file whose session_id matches CHUMP_SESSION_ID if multiple branch-match
# (should never happen, but defensive). If no claim file matches the
# current branch, emit prepush_lease_mismatch to ambient and proceed
# without blocking — a peer's claim file must not block unrelated work.
#
# Only fires when at least one claim file is present — human pushes
# without a claim pass through without noise.
#
# Bypass: add 'Off-Rails-Bypass: <reason>' trailer to HEAD commit.
# Or: CHUMP_OFF_RAILS_CHECK=0 git push
# -----------------------------------------------------------------------
if [[ "${CHUMP_OFF_RAILS_CHECK:-1}" != "0" ]]; then
    _pp_current_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    _pp_ambient="${CHUMP_AMBIENT_LOG:-$REPO_ROOT/.chump-locks/ambient.jsonl}"

    # Collect all claim files present.
    _pp_all_claims=()
    while IFS= read -r _f; do
        [[ -f "$_f" ]] && _pp_all_claims+=("$_f")
    done < <(find "$REPO_ROOT/.chump-locks" -maxdepth 1 -name 'claim-*.json' 2>/dev/null | sort || true)

    if [[ "${#_pp_all_claims[@]}" -gt 0 && -n "$_pp_current_branch" ]]; then
        # Find the claim file whose gap_id matches the current branch.
        # Expected branch form: chump/<gap-id>-claim (gap-id lowercased).
        _pp_claim_file=""
        _pp_claimed_gap=""
        _pp_available_gap_ids=""
        for _f in "${_pp_all_claims[@]}"; do
            _gap="$(jq -r '.gap_id // empty' "$_f" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
            _pp_available_gap_ids="${_pp_available_gap_ids:+$_pp_available_gap_ids,}${_gap}"
            if [[ -n "$_gap" && "$_pp_current_branch" == "chump/${_gap}-claim" ]]; then
                # Branch matches. Prefer session_id match when CHUMP_SESSION_ID is set.
                _sid="$(jq -r '.session_id // empty' "$_f" 2>/dev/null || true)"
                if [[ -n "${CHUMP_SESSION_ID:-}" && "$_sid" == "${CHUMP_SESSION_ID}" ]]; then
                    # Exact session match — use this file and stop searching.
                    _pp_claim_file="$_f"
                    _pp_claimed_gap="$_gap"
                    break
                elif [[ -z "$_pp_claim_file" ]]; then
                    # First branch match — record it; keep looking for a session match.
                    _pp_claim_file="$_f"
                    _pp_claimed_gap="$_gap"
                fi
            fi
        done

        if [[ -z "$_pp_claim_file" ]]; then
            # No claim file matches the current branch. Peer leases are present but
            # belong to other sessions/gaps. Emit diagnostic event and proceed without
            # blocking — this push is not off-rails for the current session.
            mkdir -p "$(dirname "$_pp_ambient")" 2>/dev/null || true
            printf '{"ts":"%s","kind":"prepush_lease_mismatch","branch":"%s","available_claim_files":%d,"available_gap_ids":"%s"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_pp_current_branch" \
                "${#_pp_all_claims[@]}" "$_pp_available_gap_ids" \
                >> "$_pp_ambient" 2>/dev/null || true
            echo "[pre-push] WARN (RESILIENT-026): ${#_pp_all_claims[@]} claim file(s) present but none match branch '$_pp_current_branch' — skipping branch check (peer leases present)." >&2
        else
            # Found the matching claim file. Validate current branch equals expected.
            _pp_expected="chump/${_pp_claimed_gap}-claim"
            if [[ "$_pp_current_branch" != "$_pp_expected" ]]; then
                # Check for bypass trailer on HEAD commit
                _pp_head_msg="$(git -C "$REPO_ROOT" log -1 --pretty=%B 2>/dev/null || true)"
                if grep -qE '^Off-Rails-Bypass:' <<<"$_pp_head_msg"; then
                    # Audit the bypass — log which field was bypassed
                    _pp_bypass_reason="$(grep -E '^Off-Rails-Bypass:' <<<"$_pp_head_msg" \
                        | head -1 | sed -E 's/^Off-Rails-Bypass:[[:space:]]*//')"
                    mkdir -p "$(dirname "$_pp_ambient")" 2>/dev/null || true
                    printf '{"ts":"%s","kind":"off_rails_bypassed","claimed_gap":"%s","bypassed_field":"branch","current_branch":"%s","expected_branch":"%s","reason":"%s"}\n' \
                        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_pp_claimed_gap" \
                        "$_pp_current_branch" "$_pp_expected" "$_pp_bypass_reason" \
                        >> "$_pp_ambient" 2>/dev/null || true
                else
                    echo "" >&2
                    echo "[pre-push] BLOCKED (RESILIENT-026): branch name mismatch for claimed gap." >&2
                    echo "[pre-push]   Current branch: $_pp_current_branch" >&2
                    echo "[pre-push]   Expected:       $_pp_expected" >&2
                    echo "[pre-push]   Claim file:     $_pp_claim_file" >&2
                    echo "" >&2
                    echo "[pre-push] Bypass: add 'Off-Rails-Bypass: <reason>' trailer to HEAD commit:" >&2
                    echo "[pre-push]   git commit --amend  # add the trailer at end of body" >&2
                    echo "[pre-push] Or: CHUMP_OFF_RAILS_CHECK=0 git push" >&2
                    echo "" >&2
                    exit 1
                fi
            fi
        fi
    fi
fi

# ── INFRA-2407: bypass-trailer pre-push validator ────────────────────────────
# Scans all commits being pushed for bypass tokens and validates the 4
# required trailers per docs/process/BYPASS_TRAILER_SCHEMA.md.
# Delegates to pre-push-bypass-trailers.sh; passes _HOOK_STDIN so the
# sub-script doesn't need to re-read stdin (it's already consumed above).
_BPPT_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_BPPT_GUARD="${_BPPT_SELF}/pre-push-bypass-trailers.sh"
if [[ -x "$_BPPT_GUARD" ]] && [[ "${CHUMP_BYPASS_TRAILER_CHECK:-1}" != "0" ]]; then
    if ! _HOOK_STDIN="$_HOOK_STDIN" bash "$_BPPT_GUARD" "$REMOTE" "${2:-}" >&2; then
        echo "[pre-push] bypass-trailer validation failed — push blocked (INFRA-2407)." >&2
        echo "[pre-push] Bypass: CHUMP_BYPASS_TRAILER_CHECK=0 git push" >&2
        exit 1
    fi
fi
unset _BPPT_SELF _BPPT_GUARD

exit 0
