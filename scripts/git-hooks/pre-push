        head_msg="$(git log -1 --format='%B' "$local_sha" 2>/dev/null || true)"
        if ! grep -qE '^Bot-Merge-Bypass:[[:space:]]*\S' <<<"$head_msg"; then
            echo "[pre-push] BLOCKED (INFRA-1441): CHUMP_BYPASS_BOT_MERGE=1 requires audit trailer." >&2
            echo "" >&2
            echo "[pre-push] Bypassing the bot-merge guard is fine sometimes, but the audit" >&2
            echo "[pre-push] chain needs the reason on permanent record. Add a trailer to the" >&2
            echo "[pre-push] HEAD commit body:" >&2
            echo "" >&2
            echo "[pre-push]   Bot-Merge-Bypass: <one-sentence reason>" >&2
            echo "" >&2
            echo "[pre-push] Common reasons: bot-merge stalled (INFRA-1399), test gate flake," >&2
            echo "[pre-push] doc-only PR, sibling PR contention, etc." >&2
            echo "" >&2
            echo "[pre-push] To amend the HEAD commit message:" >&2
            echo "[pre-push]   git commit --amend  # then add the trailer line at end of body" >&2
            echo "" >&2
            exit 1
        fi
