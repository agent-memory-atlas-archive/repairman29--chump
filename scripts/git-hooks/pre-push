#!/usr/bin/env bash

# --- modern-bash re-exec (INFRA-3688) -------------------------------------
# macOS ships bash 3.2, which lacks `mapfile`/`readarray` and errors on an
# empty array expanded under `set -u` — silently breaking any guard that uses
# bash-4 idioms (the actionlint + ci-regression guards among them, which is how
# the Mac kept pushing split-brained state past dead guardrails). Re-exec the
# whole hook (and everything it sources) under a bash>=4 if one exists;
# otherwise warn LOUDLY rather than no-op in silence.
if [ -z "${CHUMP_HOOK_BASH_REEXEC:-}" ] && [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
  for _cb in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [ -x "$_cb" ]; then export CHUMP_HOOK_BASH_REEXEC=1; exec "$_cb" "$0" "$@"; fi
  done
  echo "⚠ [chump-hook $(basename "$0")] bash ${BASH_VERSINFO:-3}.x too old and no bash>=4 found — guards may silently no-op. Fix: brew install bash" >&2
fi
# --------------------------------------------------------------------------
#
# Chump pre-push hook: gap-preflight guard + auto-merge armed guard.
#
# Guard 1 (gap-preflight): Automatically extracts gap IDs from commits being
# pushed and runs gap-preflight.sh against them. Aborts if any gap is already
# `done` on origin/main or claimed by another session — preventing wasted CI
# runs and duplicate work landing.
# Bypass: CHUMP_GAP_CHECK=0 git push  (use when gap IDs in commit bodies cause false positives)
#
# Guard 2 (auto-merge armed): Queries `gh pr view` for the target branch and
# aborts if the PR already has auto-merge armed. This prevents the PR #52
# footgun where 11 commits were lost because an agent kept pushing after
# auto-merge was armed and GitHub captured the branch at first-CI-green.
# Bypass: CHUMP_AUTOMERGE_OVERRIDE=1 git push  (emergency use only)
#
# Auto-skip (INFRA-368): When `git reflog` shows a "rebase" entry within the
# last REBASE_DETECT_WINDOW_S seconds (default 300), Guards 1+2 silently
# auto-skip. The canonical DIRTY-after-arm recovery is "rebase + force-push" —
# the auto-merge-armed guard would otherwise treat it as the PR #52 footgun.
# Guard 3 still runs (race protection applies regardless). Disable detection
# with CHUMP_REBASE_DETECT=0.
#
# Guard 3 (force-with-lease race protection — INFRA-345): On a force-push,
# verifies the actual current remote tip matches what the local fetched view
# expected. `git push --force-with-lease` only protects against the ref-tip
# you've fetched moving — it does NOT protect against a sibling pushing
# between your fetch and your push (the lease-check uses your stale local
# refs/remotes/<remote>/<branch>). PR #910 incident, 2026-05-03: clobbered a
# sibling's commit b484c152 that landed in the ~2-minute window between my
# fetch and my push. This guard does a fresh `git ls-remote` immediately
# before allowing a force-push and aborts if the remote tip has moved.
# Bypass: CHUMP_FORCE_LEASE_CHECK=0 git push  (use when intentional)
#
# Guard 0e (merge-tree DIRTY conflict pre-check — INFRA-1391): Runs
# `git merge-tree <base> origin/main HEAD` before the push and aborts if
# the output contains conflict markers. Catches the "push → 20min CI → DIRTY"
# cycle in <2s locally. Bypass: CHUMP_MERGE_PREVIEW=0 git push
#
# Guard 4 (bot-merge required for new gap branches — INFRA-719): On a
# first-push (new branch) of a chump/<gap-id>-* branch, requires that the
# push was initiated by bot-merge.sh (CHUMP_BOT_MERGE_IN_PROGRESS=1).
# Prevents the "git push -u origin branch + gh pr create" manual bypass which
# skips gap-ship-fatal (INFRA-678) and the auto-close hook (INFRA-154).
# Bypass: CHUMP_BYPASS_BOT_MERGE=1 git push  (rare; add a comment why)
#
# Install once: ./scripts/setup/install-hooks.sh
#
# INFRA-1997 Phase 1: feature-flagged Rust shim. When CHUMP_PREPUSH_RUST=1
# and the `chump-pre-push` binary is on PATH, this hook exec's the binary
# and the legacy bash path is skipped. Otherwise the bash hook runs
# unchanged. Both implementations stay side-by-side during a 1-week
# parallel-validation window; cutover to Rust default is a separate gap.
#
# The binary handles env-immunity (scrubs GIT_DIR / GIT_WORK_TREE /
# GITHUB_WORKSPACE / GIT_COMMON_DIR / GIT_INDEX_FILE at entry, then
# discovers repo root via env_clear()'d git subprocess) — the failure
# class behind INFRA-1950 / TRUNK_RED 2026-05-23.

set -euo pipefail

# ----- INFRA-1997 Phase 1 Rust shim ---------------------------------------
if [[ "${CHUMP_PREPUSH_RUST:-0}" == "1" ]] && command -v chump-pre-push &>/dev/null; then
    exec chump-pre-push "$@"
fi
# --------------------------------------------------------------------------

# INFRA-1950: resolve repo root from the hook's own location so all internal
# `git` calls use an explicit `-C "$REPO_ROOT"` rather than inheriting ambient
# GIT_DIR / GITHUB_WORKSPACE from the Actions runner-listener process. Without
# this, Guard 3's `git merge-base` and `git ls-remote` resolve against the
# wrong repo context when the hook is invoked under GitHub Actions self-hosted
# runners (which leak GIT_DIR into child processes).
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# INFRA-1588: ERR trap so SIGPIPE / set -e failures don't abort the hook
# silently. Without this, `git push` prints "failed to push some refs" with
# no diagnostic — the operator has no idea which line failed (4 ships hit
# this on 2026-05-16: #2250, #2251, #2252, #2254). The trap MUST be after
# `set -e`/`-o pipefail` so it actually fires; placement here is load-bearing.
# Capture exit-status before any further commands clobber $? .
trap 'rc=$?; echo "[pre-push] hook aborted at line $LINENO with exit $rc" >&2; exit $rc' ERR

# Never block pushes to main/master — those go through PR only.
REMOTE="$1"
# $2 is the remote URL; unused here.

# -----------------------------------------------------------------------
# INFRA-1028: operator-recovery umbrella
# CHUMP_OPERATOR_RECOVERY=1 enables the bypass set for human-supervised
# manual recovery. Emits guard_bypassed to ambient.jsonl for audit trail.
# -----------------------------------------------------------------------
if [ "${CHUMP_OPERATOR_RECOVERY:-0}" = "1" ]; then
    export CHUMP_BYPASS_BOT_MERGE=1
    export CHUMP_GAP_CHECK=0
    export CHUMP_ALLOW_UNREGISTERED_GAP=1
    export CHUMP_ALLOW_REUSE_BRANCH=1
    export CHUMP_ALLOW_GAP_REWRITE=1
    export CHUMP_TEST_GATE=0
    export CHUMP_MERGE_PREVIEW=0
    _or_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    _or_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    mkdir -p "${_or_root}/.chump-locks" 2>/dev/null || true
    printf '{"ts":"%s","kind":"guard_bypassed","guard_name":"operator_recovery_umbrella","bypasses":["CHUMP_BYPASS_BOT_MERGE","CHUMP_GAP_CHECK","CHUMP_TEST_GATE","CHUMP_ALLOW_UNREGISTERED_GAP"],"operator":true}\n' \
        "$_or_ts" >> "${_or_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
    unset _or_ts _or_root
fi

# -----------------------------------------------------------------------
# INFRA-1986: cache stdin ONCE up front.
#
# Git invokes pre-push with a stdin stream of one "local_ref local_sha
# remote_ref remote_sha\n" line per ref. Several blocks below want to
# inspect those refs (Guard 0a preflight, Guard 0b clippy ref-detector,
# the main Guard 1/2/3 loop). Stdin is a one-shot — once consumed, the
# downstream loops see EOF, silently iterate zero times, and we sail past
# Guard 3 with no protection.
#
# Regression history: INFRA-1927 added the Guard 0a loop at line ~120
# WITHOUT redirecting it to a cached buffer. The Guard 0b loop at line
# ~200 already drained whatever was left, leaving the main Guard 1/2/3
# loop with empty stdin. test-pre-push-force-lease-guard.sh Test 1 went
# silently green (rc=0, no output) — i.e. force-push race protection was
# OFF in production for the duration INFRA-1927 was live.
#
# Fix: read all of stdin into _HOOK_STDIN once, then feed each loop with
#   `while ... done <<< "$_HOOK_STDIN"` so every loop sees the full input.
# -----------------------------------------------------------------------
_HOOK_STDIN="$(cat || true)"

# -----------------------------------------------------------------------
# INFRA-5126 (INFRA-1861 slice): pre-push phase + total hard timeout.
#
# The fast, supposed-to-be-seconds guards below (fmt --check, the fmt
# auto-fix gate, clippy, merge-tree conflict preview) had NO timeout
# protection — a hung `cargo`/`git` invocation (disk stall, dead sccache
# server, lock contention) blocked the push indefinitely with zero
# diagnostic. This is deliberately separate from the cargo-TEST gate's own
# INFRA-1744 timeout (up to CHUMP_PREPUSH_TEST_TIMEOUT_S, default 600s) —
# a full test run legitimately takes minutes, so it is not wrapped here.
#
# Each wrapped phase aborts after CHUMP_PREPUSH_PHASE_TIMEOUT_S (default
# 30s). The cumulative wall-clock spent since hook start aborts the whole
# hook after CHUMP_PREPUSH_TOTAL_TIMEOUT_S (default 90s), checked at the
# entry of each wrapped phase. Both cases emit kind=prepush_timeout and
# exit non-zero (the pre-push contract: non-zero exit aborts `git push`).
# -----------------------------------------------------------------------
# INFRA-5126:BEGIN-TIMEOUT-HELPERS
_PP_PHASE_TIMEOUT_S="${CHUMP_PREPUSH_PHASE_TIMEOUT_S:-30}"
_PP_TOTAL_TIMEOUT_S="${CHUMP_PREPUSH_TOTAL_TIMEOUT_S:-90}"
_PP_HOOK_START_EPOCH="$(date +%s)"

# args: phase timeout_s elapsed_s reason
_pp_emit_timeout_event() {
    local _phase="$1" _timeout_s="$2" _elapsed_s="$3" _reason="$4"
    local _pp_root _pp_branch _pp_gap _pp_amb
    _pp_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    _pp_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    _pp_gap="$(echo "$_pp_branch" | grep -oiE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]' || echo "")"
    _pp_amb="${CHUMP_AMBIENT_LOG:-$_pp_root/.chump-locks/ambient.jsonl}"
    mkdir -p "$(dirname "$_pp_amb")" 2>/dev/null || true
    printf '{"ts":"%s","kind":"prepush_timeout","phase":"%s","timeout_s":%s,"elapsed_s":%s,"reason":"%s","branch":"%s","gap_id":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_phase" "$_timeout_s" "$_elapsed_s" "$_reason" "$_pp_branch" "$_pp_gap" \
        >> "$_pp_amb" 2>/dev/null || true
}

# Aborts the hook if cumulative wall-clock since hook start already exceeds
# the total budget. Call at the top of each timeout-wrapped guard, before
# it starts its (potentially slow) work.
_pp_check_total_budget() {
    local _phase="$1"
    local _now _elapsed
    _now="$(date +%s)"
    _elapsed=$(( _now - _PP_HOOK_START_EPOCH ))
    if [[ "$_elapsed" -ge "$_PP_TOTAL_TIMEOUT_S" ]]; then
        echo "" >&2
        echo "[pre-push] BLOCKED (INFRA-5126): total pre-push hook budget (${_PP_TOTAL_TIMEOUT_S}s) exceeded before phase '${_phase}'." >&2
        echo "[pre-push] Elapsed: ${_elapsed}s. Raise the budget: CHUMP_PREPUSH_TOTAL_TIMEOUT_S=<secs> git push" >&2
        echo "" >&2
        _pp_emit_timeout_event "$_phase" "$_PP_TOTAL_TIMEOUT_S" "$_elapsed" "total_budget_exceeded"
        exit 1
    fi
}

# Runs "$@" under a per-phase timeout, after checking the total budget.
# On phase timeout (rc=124) emits the ambient event + a diagnostic, then
# returns 124 to the caller — callers already treat any non-zero return
# from their command as a failure, so this composes with existing
# guard-specific bypass/diagnostic text without changing control flow.
_pp_run_timed() {
    local _phase="$1"; shift
    _pp_check_total_budget "$_phase"
    local _t0 _rc _elapsed _phase_timeout
    # RESILIENT-1448: per-phase budget. fmt --check is a genuine fast guard
    # (30s is plenty). clippy is a COMPILE-bearing gate: even a WARM,
    # incremental `cargo clippy --all-targets` re-lints the whole workspace
    # and runs well over 30s on a small box, so the fast-guard budget
    # false-killed a legitimate clippy and blocked the push. Give clippy its
    # own generous-but-bounded budget (mirrors the cargo-test gate INFRA-1744
    # timeout); a genuinely hung cargo still aborts. clippy is the LAST
    # budget-checked phase in this hook, so a longer clippy never trips a
    # later phase total-budget check.
    _phase_timeout="$_PP_PHASE_TIMEOUT_S"
    if [[ "$_phase" == "clippy" ]]; then
        _phase_timeout="${CHUMP_PREPUSH_CLIPPY_TIMEOUT_S:-600}"
    fi
    _t0="$(date +%s)"
    timeout "${_phase_timeout}s" "$@"
    _rc=$?
    if [[ "$_rc" -eq 124 ]]; then
        _elapsed=$(( $(date +%s) - _t0 ))
        echo "" >&2
        echo "[pre-push] BLOCKED (INFRA-5126): phase '${_phase}' exceeded ${_phase_timeout}s." >&2
        echo "[pre-push] Raise the per-phase budget: CHUMP_PREPUSH_PHASE_TIMEOUT_S=<secs> git push (clippy: CHUMP_PREPUSH_CLIPPY_TIMEOUT_S)" >&2
        echo "" >&2
        _pp_emit_timeout_event "$_phase" "$_phase_timeout" "$_elapsed" "phase_timeout"
    fi
    return "$_rc"
}
# INFRA-5126:END-TIMEOUT-HELPERS

# -----------------------------------------------------------------------
# INFRA-1988 (THE FLOOR Phase 2): silent-noop alarm.
#
# If the main Guard 1/2/3 loop NEVER enters its body on a non-trivial push,
# we silently sail through with rc=0 — the exact INFRA-1986 failure mode.
# This sentinel + EXIT trap converts that invisible failure into a visible
# ambient event so we'd catch the next regression in hours, not days.
#
# Non-trivial push = ≥1 line in stdin with a real (non-zero) remote_sha or
# local_sha. New-branch pushes (all-zero remote) are exempted via the
# default Guard 4 logic; we use the same check here.
# -----------------------------------------------------------------------
_HOOK_LOOP_ENTERED=0
_HOOK_NAME="pre-push"
_silent_alarm_check_and_emit() {
    local rc="$?"
    # Skip alarm if we exited non-zero (the hook reported a failure — that's
    # the LOUD path, no alarm needed).
    [[ "$rc" -ne 0 ]] && return "$rc"
    # Skip if stdin was empty or zero-only (trivial push).
    local _stdin_nontrivial=0
    if [[ -n "$_HOOK_STDIN" ]]; then
        # Any line with a non-zero SHA in either local_sha (col 2) or remote_sha (col 4)?
        if echo "$_HOOK_STDIN" | awk '$2 !~ /^0+$/ || $4 !~ /^0+$/ {found=1} END {exit !found}' 2>/dev/null; then
            _stdin_nontrivial=1
        fi
    fi
    # If main loop body never executed on a non-trivial push → emit alarm.
    if [[ "$_HOOK_LOOP_ENTERED" -eq 0 ]] && [[ "$_stdin_nontrivial" -eq 1 ]]; then
        local _amb_root _amb_path
        _amb_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
        _amb_path="${CHUMP_AMBIENT_LOG:-$_amb_root/.chump-locks/ambient.jsonl}"
        mkdir -p "$(dirname "$_amb_path")" 2>/dev/null || true
        printf '{"ts":"%s","kind":"hook_silent_passthrough","source":"%s","hook":"%s","reason":"main_loop_did_not_execute_on_nontrivial_push","stdin_lines":%d}\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "pre_push_hook" \
            "$_HOOK_NAME" \
            "$(echo "$_HOOK_STDIN" | wc -l | xargs)" \
            >> "$_amb_path" 2>/dev/null || true
    fi
    return "$rc"
}
trap _silent_alarm_check_and_emit EXIT

# -----------------------------------------------------------------------
# Guard 0-verify-claim-branch (INFRA-1649, re-do of INFRA-1598)
#
# Fast-fail mirror of Guard 5 (below) using the `chump verify-claim-branch`
# Rust primitive instead of re-parsing claim-*.json with jq. Runs FIRST,
# ahead of every other guard, so a wrong-branch push (INFRA-1427 failure
# class: linked-worktree gitdir back-reference resolves HEAD via a
# different session's branch) is caught before any expensive check runs.
# Guard 5 stays in place as the harness-neutral fallback for hosts without
# the `chump` binary on PATH.
#
# Bypass: same trailer as Guard 5 — 'Off-Rails-Bypass: <reason>' on HEAD,
# or CHUMP_OFF_RAILS_CHECK=0 git push.
# -----------------------------------------------------------------------
if command -v chump &>/dev/null && [[ "${CHUMP_OFF_RAILS_CHECK:-1}" != "0" ]]; then
    if ! chump verify-claim-branch >/dev/null 2>&1; then
        _pp_head_msg="$(git -C "$REPO_ROOT" log -1 --pretty=%B 2>/dev/null || true)"
        if grep -qE '^Off-Rails-Bypass:' <<<"$_pp_head_msg"; then
            : # bypass trailer present — Guard 5 below will audit-log it
        else
            chump verify-claim-branch >&2 || true
            echo "[pre-push] Bypass: add 'Off-Rails-Bypass: <reason>' trailer to HEAD commit, or CHUMP_OFF_RAILS_CHECK=0 git push" >&2
            exit 1
        fi
    fi
fi

# -----------------------------------------------------------------------
# Guard 0a: chump preflight (INFRA-1671)
#
# The single-command local CI mirror (INFRA-1670). When the `chump` binary
# is available and the push includes Rust or scripts changes, run preflight
# upfront. It catches the same failure classes as Guards 0/0b/0c (fmt,
# clippy, check) PLUS the structural test-*.sh classes (DOC-026 env-var
# coverage, INFRA-682 path-filter, INFRA-1287 registry-orphan, etc.) that
# the downstream guards don't cover.
#
# Order matters: preflight is INTENTIONALLY before Guards 0/0b/0c. If
# preflight passes, the downstream guards are running on already-validated
# code (cheap on warm cache). If preflight catches something, the operator
# gets the comprehensive diagnostic without waiting for individual guards.
#
# Skip conditions (preflight is opt-out, not mandatory):
#   - `chump` binary not on PATH (early bootstrap; rely on downstream guards)
#   - Push has zero rust/scripts content (doc-only PR; preflight has nothing useful)
#
# INFRA-2422: CHUMP_PREFLIGHT_SKIP deleted. When origin/main is already
# failing a gate, preflight auto-skips only those failing gates internally.
# No env override is accepted or needed.
# -----------------------------------------------------------------------
if command -v chump &>/dev/null \
   && chump preflight --help &>/dev/null; then
    preflight_has_targets=0
    while IFS=' ' read -r local_sha local_ref remote_sha _remote_ref; do
        [[ -z "$local_sha" ]] && continue
        if [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
        if [[ "$remote_sha" =~ ^0+$ ]]; then
            range_base="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "")"
            [[ -z "$range_base" ]] && range_base="origin/main"
        else
            range_base="$remote_sha"
        fi
        # Match what preflight cares about: Rust + scripts + Cargo manifests.
        if git diff --name-only "$range_base..$local_sha" 2>/dev/null \
            | grep -qE '\.(rs|sh)$|^Cargo\.(toml|lock)$|^crates/|^src/|^scripts/'; then
            preflight_has_targets=1
            break
        fi
    done <<<"$_HOOK_STDIN"

    # INFRA-3521: skip the preflight re-run when the push is bot-merge-initiated.
    # bot-merge already runs fmt/clippy/test as its own gates before pushing and
    # deliberately delegates the heavy suite to CI (INFRA-1399), so re-running
    # `chump preflight` in this hook is pure redundancy — and a cold compile here
    # regularly blows bot-merge's 300s push-phase budget (INFRA-2426), which
    # SIGTERMs the push mid-flight and orphans the worktree (→ META-156 re-claim
    # failure on the next attempt). CI on the PR is the authoritative gate.
    # Direct (non-bot-merge) `git push` still runs the full preflight below.
    if [[ "$preflight_has_targets" -eq 1 && "${CHUMP_BOT_MERGE_IN_PROGRESS:-0}" == "1" ]]; then
        echo "[pre-push] INFRA-3521: skipping preflight re-run — bot-merge already gated this push; CI is authoritative." >&2
        preflight_has_targets=0
        _amb_3521="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.chump-locks/ambient.jsonl"
        printf '{"ts":"%s","kind":"prepush_preflight_skipped_botmerge","reason":"INFRA-3521: bot-merge already gated + CI authoritative"}\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$_amb_3521" 2>/dev/null || true
        unset _amb_3521
    fi

    if [[ "$preflight_has_targets" -eq 1 ]]; then
        echo "[pre-push] INFRA-1671: running chump preflight ..." >&2
        _pf_start="$(date +%s)"
        _pf_rc=0
        chump preflight 2>&1 || _pf_rc=$?

        # INFRA-1927: emit preflight_ci_agreement for agreement-rate measurement.
        # Bypass: CHUMP_PREFLIGHT_CI_AGREEMENT=0
        if [[ "${CHUMP_PREFLIGHT_CI_AGREEMENT:-1}" != "0" ]]; then
            _pf_end="$(date +%s)"
            _pf_secs=$(( _pf_end - _pf_start ))
            _pf_sha="$(git rev-parse HEAD 2>/dev/null || echo "")"
            _pf_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
            _pf_gap="$(echo "$_pf_branch" | grep -oiE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]' || echo "")"
            _pf_pass="false"
            [[ "$_pf_rc" -eq 0 ]] && _pf_pass="true"
            _pf_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
            _pf_wt_list="$(git worktree list --porcelain 2>/dev/null || true)"
            _pf_main_repo="$(awk '/^worktree / {print $2; exit}' <<<"$_pf_wt_list")"
            [[ -n "$_pf_main_repo" && -d "$_pf_main_repo/.chump-locks" ]] && _pf_root="$_pf_main_repo"
            _pf_ambient="${CHUMP_AMBIENT_LOG:-$_pf_root/.chump-locks/ambient.jsonl}"
            mkdir -p "$(dirname "$_pf_ambient")" 2>/dev/null || true
            printf '{"ts":"%s","kind":"preflight_ci_agreement","sha":"%s","branch":"%s","gap_id":"%s","preflight_pass":%s,"preflight_secs":%d}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_pf_sha" "$_pf_branch" "$_pf_gap" \
                "$_pf_pass" "$_pf_secs" \
                >> "$_pf_ambient" 2>/dev/null || true
            unset _pf_end _pf_sha _pf_branch _pf_gap _pf_pass _pf_root _pf_wt_list _pf_main_repo _pf_ambient
        fi
        unset _pf_start _pf_secs

        if [[ "$_pf_rc" -ne 0 ]]; then
            echo "" >&2
            echo "[pre-push] BLOCKED: chump preflight failed (INFRA-1671)." >&2
            echo "[pre-push] Fix the failing gate(s) and try again." >&2
            echo "[pre-push] If origin/main is also RED, preflight auto-skips those gates (INFRA-2422)." >&2
            echo "" >&2
            unset _pf_rc
            exit 1
        fi
        unset _pf_rc
    fi
fi

# -----------------------------------------------------------------------
# Guard 0: cargo fmt --check (INFRA-749)
#
# Fleet workers can bypass the pre-commit hook (--no-verify) or skip
# bot-merge.sh entirely, pushing unformatted code that blocks CI. This
# guard catches the gap: it runs at push time, is independent of how
# commits were created, and is fast (~1-2s on cached builds).
# Bypass: CHUMP_FMT_CHECK=0 git push
# -----------------------------------------------------------------------
if [[ "${CHUMP_FMT_CHECK:-1}" != "0" ]] && command -v cargo &>/dev/null; then
    # INFRA-1398: gate on the PUSH DELTA's .rs content, not on whether the repo
    # has any Rust files at all. Pre-1398 the `ls src/**/*.rs` glob was always
    # true (chump is a Rust repo), so doc-only / ci.yml-only pushes ran
    # cargo fmt --check unnecessarily — slow + irrelevant.
    #
    # Push range: stdin gives `<local-sha> <local-ref> <remote-sha> <remote-ref>`.
    # When we cannot derive a range (first-push of a new branch, no stdin
    # available because hook called manually), fall back to the OLD behaviour
    # (run on every push) — safer default.
    push_has_rust=0
    while IFS=' ' read -r local_sha local_ref remote_sha _remote_ref; do
        [[ -z "$local_sha" ]] && continue
        # Skip branch deletions (local_sha all zeros).
        if [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
        # First push of branch: remote_sha is zeros → compare against origin/main.
        if [[ "$remote_sha" =~ ^0+$ ]]; then
            range_base="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "")"
            [[ -z "$range_base" ]] && range_base="origin/main"
        else
            range_base="$remote_sha"
        fi
        if git diff --name-only "$range_base..$local_sha" 2>/dev/null | grep -qE '\.rs$'; then
            push_has_rust=1
            break
        fi
    done <<<"$_HOOK_STDIN"
    # Conservative fallback: if we couldn't read stdin (manual invocation) AND
    # the repo has Rust files, run the check to avoid silently letting bad
    # code through.
    if [[ "$push_has_rust" -eq 0 ]] && [[ -t 0 ]] && ls src/**/*.rs &>/dev/null 2>&1; then
        push_has_rust=1
    fi
    if [[ "$push_has_rust" -eq 1 ]]; then
        if ! _pp_run_timed fmt_check cargo fmt --all -- --check >/dev/null 2>&1; then
            echo "" >&2
            echo "[pre-push] BLOCKED: cargo fmt --check failed (INFRA-749)." >&2
            echo "[pre-push] Unformatted Rust code cannot be pushed — CI will reject it." >&2
            echo "" >&2
            echo "[pre-push] Fix: cargo fmt --all && git add -u && git commit --amend --no-edit" >&2
            echo "[pre-push] Bypass: CHUMP_FMT_CHECK=0 git push" >&2
            echo "" >&2
            exit 1
        fi
    fi
fi

# -----------------------------------------------------------------------
# Guard 0d: drop ghost test-fixture commits (INFRA-1408)
#
# Some CI test scripts (notably scripts/ci/test-api-broadcast.sh and
# scripts/ci/test-claim-*.sh) run `git init && git add -A && git commit -m s`
# inside scratch dirs to fabricate fixture repos. When those scratch dirs
# overlap with the repo (or when a sibling-bot pushes into a feature branch),
# the resulting "init" commits authored by `Test <test@test.local>` leak into
# real PR branches and get caught by pr-hygiene (CREDIBLE-027) at CI time —
# wasting one full CI cycle per occurrence.
#
# This guard scans the commits being pushed (zero-arg local-ref form of pre-
# push input). For any commit authored by a name matching the fixture regex
# (default '^Test.*@test\.local$'), it prints a warning and refuses the push.
# Operator can interactively drop them via `git rebase --interactive base~N`
# or pass --auto-drop to have the hook do it.
#
# Bypass: CHUMP_FIXTURE_AUTHOR_GUARD=0 git push
# Auto-drop: CHUMP_AUTODROP_FIXTURE_COMMITS=1 git push  (rewrites HEAD)
# Tune regex: CHUMP_FIXTURE_AUTHOR_REGEX='^Test.*@test\.local$|^Fixture<.*>$'
# -----------------------------------------------------------------------
if [[ "${CHUMP_FIXTURE_AUTHOR_GUARD:-1}" != "0" ]]; then
    # Match by domain — the actual ghost commits observed today had
    # author email "test@test.local" (lowercase) so we key on the .local
    # TLD specifically since real authors use .com/.dev/.org/etc.
    _fa_regex="${CHUMP_FIXTURE_AUTHOR_REGEX:-@(test|fixture|example)\.local$}"
    # Read stdin only when we have one; pre-push hooks get refs on stdin.
    # The git revisions to scan are determined by the diff between the
    # being-pushed ref and its remote tracking ref. If there is no remote
    # tracking ref (new branch), scan everything not yet on origin/main.
    _fa_local_sha="$(git rev-parse HEAD 2>/dev/null || echo HEAD)"
    _fa_base="$(git merge-base "$_fa_local_sha" origin/main 2>/dev/null || echo "")"
    if [[ -n "$_fa_base" && "$_fa_base" != "$_fa_local_sha" ]]; then
        # INFRA-1588: read-then-parse — git log can produce many commits;
        # piping through grep|awk under pipefail risked SIGPIPE if a later
        # short-circuit was added. Materialising first removes that hazard.
        _fa_log="$(git log --format='%H %ae' "${_fa_base}..${_fa_local_sha}" 2>/dev/null || true)"
        _fa_ghosts="$(grep -E " ${_fa_regex}" <<<"$_fa_log" | awk '{print $1}' || true)"
        if [[ -n "$_fa_ghosts" ]]; then
            echo "" >&2
            echo "[pre-push] BLOCKED: $(echo "$_fa_ghosts" | wc -l | tr -d ' ') ghost commit(s) authored by Test<test@test.local> or similar detected (INFRA-1408)." >&2
            echo "[pre-push] These leak from CI test fixtures running 'git init' in shared dirs and trigger pr-hygiene/CREDIBLE-027 at CI time." >&2
            echo "" >&2
            echo "$_fa_ghosts" | while read -r _sha; do
                git log -1 --format='  %h %ae — %s' "$_sha" >&2
            done
            echo "" >&2
            if [[ "${CHUMP_AUTODROP_FIXTURE_COMMITS:-0}" = "1" ]]; then
                echo "[pre-push] CHUMP_AUTODROP_FIXTURE_COMMITS=1 — attempting auto-drop via rebase --onto" >&2
                # Build a rebase --onto base ghost~ HEAD for each (in order)
                # Simplest reliable approach: cherry-pick all non-ghost commits onto base
                # INFRA-1588: same read-then-parse pattern for the auto-drop branch.
                _fa_keep_log="$(git log --format='%H %ae' "${_fa_base}..${_fa_local_sha}" --reverse 2>/dev/null || true)"
                _fa_keep="$(grep -vE " ${_fa_regex}" <<<"$_fa_keep_log" | awk '{print $1}' || true)"
                unset _fa_keep_log
                _fa_branch="$(git rev-parse --abbrev-ref HEAD)"
                git checkout -q "$_fa_base"
                _fa_failed=0
                for _sha in $_fa_keep; do
                    if ! git cherry-pick "$_sha" >/dev/null 2>&1; then
                        _fa_failed=1
                        git cherry-pick --abort >/dev/null 2>&1 || true
                        break
                    fi
                done
                if [[ $_fa_failed -eq 1 ]]; then
                    git checkout -q "$_fa_branch"
                    echo "[pre-push] auto-drop failed; manual fix required: git rebase -i $_fa_base" >&2
                    exit 1
                fi
                git branch -f "$_fa_branch" HEAD
                git checkout -q "$_fa_branch"
                # Emit ambient event
                _fa_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
                _fa_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                printf '{"ts":"%s","kind":"fixture_commit_dropped","branch":"%s","dropped_count":%d}\n' \
                    "$_fa_ts" "$_fa_branch" "$(echo "$_fa_ghosts" | wc -l | tr -d ' ')" \
                    >> "${_fa_repo_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
                unset _fa_ts _fa_repo_root
                echo "[pre-push] auto-drop succeeded — ghost commits removed from $_fa_branch" >&2
            else
                echo "[pre-push] Drop manually: git rebase -i $_fa_base    (delete the ghost lines)" >&2
                echo "[pre-push] Or: CHUMP_AUTODROP_FIXTURE_COMMITS=1 git push   (rewrites local branch)" >&2
                echo "[pre-push] Bypass:    CHUMP_FIXTURE_AUTHOR_GUARD=0 git push" >&2
                echo "" >&2
                exit 1
            fi
        fi
    fi
    unset _fa_regex _fa_local_sha _fa_base _fa_ghosts _fa_keep _fa_log _fa_branch _fa_failed _sha
fi

# -----------------------------------------------------------------------
# Guard 0e: merge-tree DIRTY conflict pre-check (INFRA-1391)
#
# Runs `git merge-tree <base> origin/main HEAD` to detect semantic
# conflicts with main BEFORE pushing — catches the "push → 20min CI →
# DIRTY → rebase" cycle by failing in <2s locally.
#
# The three-tree form is used for portability across git versions.
# Exit-on-first-conflict: once the output contains a conflict marker
# (<<<<<<<) we stop, print the files involved, and refuse the push.
#
# Skip-flag: CHUMP_MERGE_PREVIEW=0 git push
#   Logs kind=merge_preview_skipped to ambient.jsonl with gap_id +
#   branch so waste-tally can track voluntary bypasses.
# -----------------------------------------------------------------------
if [[ "${CHUMP_MERGE_PREVIEW:-1}" == "0" ]]; then
    _mp_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    _mp_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    _mp_gap="$(echo "$_mp_branch" | grep -oiE '[A-Za-z]+-[0-9]+' | head -1 \
        | tr '[:lower:]' '[:upper:]' || echo "")"
    printf '{"ts":"%s","kind":"merge_preview_skipped","gap_id":"%s","branch":"%s","bypassed_by":"CHUMP_MERGE_PREVIEW=0"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_mp_gap" "$_mp_branch" \
        >> "${_mp_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
    unset _mp_root _mp_branch _mp_gap
elif command -v git &>/dev/null; then
    # Fetch latest main so the merge-tree comparison is current.
    git fetch origin main --quiet 2>/dev/null || true
    _mp_base="$(git merge-base HEAD origin/main 2>/dev/null || echo "")"
    _mp_head="$(git rev-parse HEAD 2>/dev/null || echo "")"
    # Only check when HEAD is actually ahead of main (skip clean/up-to-date branches).
    if [[ -n "$_mp_base" && "$_mp_base" != "$_mp_head" ]]; then
        # Three-tree merge-tree: base, ours (origin/main), theirs (HEAD).
        # Conflict markers appear as lines starting with +<<<<<<<, +=======,
        # +>>>>>>> in the diff output section.
        # INFRA-5126: per-phase timeout — a hung merge-tree (rare, but seen
        # under disk contention) previously blocked the push indefinitely.
        _pp_check_total_budget merge_tree_preview
        _mp_rc=0
        _mp_out="$(timeout "${_PP_PHASE_TIMEOUT_S}s" git merge-tree "$_mp_base" origin/main HEAD 2>/dev/null)" || _mp_rc=$?
        if [[ "$_mp_rc" -eq 124 ]]; then
            _pp_emit_timeout_event merge_tree_preview "$_PP_PHASE_TIMEOUT_S" "$_PP_PHASE_TIMEOUT_S" phase_timeout
            echo "" >&2
            echo "[pre-push] BLOCKED (INFRA-5126): merge-tree preview exceeded ${_PP_PHASE_TIMEOUT_S}s." >&2
            echo "[pre-push] Raise the per-phase budget: CHUMP_PREPUSH_PHASE_TIMEOUT_S=<secs> git push" >&2
            echo "" >&2
            exit 1
        fi
        if grep -qE '^\+<{6,7} ' <<<"$_mp_out"; then
            # Extract conflicting file names from the diff header lines.
            # INFRA-1588: avoid SIGPIPE — `head -10` can close the pipe while
            # upstream grep/sed/awk are still feeding from the (potentially
            # large) merge-tree dump. Materialise the intermediate result, then
            # cap with awk-NR instead of piping through head.
            _mp_diffhdrs="$(grep -E '^(diff --cc |diff --git a/)' <<<"$_mp_out" \
                | sed -E 's/^diff --cc //; s/^diff --git a\///' \
                | awk '{print $1}' | sort -u || true)"
            _mp_files="$(awk 'NR<=10 {print}' <<<"$_mp_diffhdrs" | tr '\n' ' ')"
            unset _mp_diffhdrs
            _mp_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
            _mp_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
            echo "" >&2
            echo "[pre-push] BLOCKED (INFRA-1391): DIRTY conflict with origin/main detected." >&2
            echo "[pre-push] Conflict files: ${_mp_files:-<see merge-tree output>}" >&2
            echo "[pre-push] Run:" >&2
            echo "[pre-push]   git fetch origin main && git rebase origin/main" >&2
            echo "[pre-push]   # resolve conflicts, git add, git rebase --continue, re-push" >&2
            echo "[pre-push] Bypass (off-main work, e.g. long-running feature branch):" >&2
            echo "[pre-push]   CHUMP_MERGE_PREVIEW=0 git push" >&2
            echo "" >&2
            # Emit ambient event for waste-tally.
            printf '{"ts":"%s","kind":"merge_preview_dirty","branch":"%s","conflict_files":"%s"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_mp_branch" \
                "$(echo "${_mp_files}" | sed 's/ *$//')" \
                >> "${_mp_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
            unset _mp_base _mp_head _mp_out _mp_files _mp_branch _mp_root
            exit 1
        fi
    fi
    unset _mp_base _mp_head _mp_out
fi

# -----------------------------------------------------------------------
# Guard 0b-fmt: cargo fmt gate (INFRA-3512 / COTG-2.6)
#
# The pre-COMMIT hook auto-fmts staged .rs, but `--no-verify` commits (and any
# non-hook path) bypass it — so fmt drift still reached CI and BLOCKED a 5-deep
# stack (2026-07-29). fmt is 100% deterministic AND auto-fixable; there is no
# reason it should ever fail CI. This is the last line before the push: on a .rs
# change, if `cargo fmt --all --check` fails, AUTO-APPLY the fix and BLOCK so the
# operator commits it. Drift never reaches CI, regardless of how the commit was
# made. Fast (fmt is syntactic, no build). Bypass: CHUMP_FMT_GATE=0.
# -----------------------------------------------------------------------
if [[ "${CHUMP_LINT_GATE:-on}" != "off" && "${CHUMP_FMT_GATE:-1}" != "0" ]] \
   && command -v cargo &>/dev/null; then
    _FMT_HAS_RS=0
    if git diff --name-only origin/main...HEAD 2>/dev/null | grep -qE '\.rs$' \
       || git diff --name-only HEAD 2>/dev/null | grep -qE '\.rs$'; then
        _FMT_HAS_RS=1
    fi
    if [[ "$_FMT_HAS_RS" == "1" ]] && ! _pp_run_timed fmt_gate cargo fmt --all -- --check > /dev/null 2>&1; then
        echo "[pre-push] BLOCKED (INFRA-3512): cargo fmt drift detected — auto-applying the fix." >&2
        cargo fmt --all > /dev/null 2>&1 || true
        echo "[pre-push] Applied. Commit the formatting and re-push:" >&2
        echo "[pre-push]   git add -A && git commit --amend --no-edit   # or a new 'style: cargo fmt' commit" >&2
        echo "[pre-push] fmt is deterministic + auto-fixable — it must never reach CI. Bypass: CHUMP_FMT_GATE=0" >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------
# Guard 0c: cargo clippy lint gate (INFRA-1390)
#
# Runs cargo clippy on changed crates before the full test suite so
# lint-class CI failures are caught locally in ~10s rather than after a
# 20-min CI cycle.  Only fires when .rs files are changed in the diff.
#
# Disk-pressure guard: clippy on a large codebase needs ~200MB workspace.
# If < CHUMP_CLIPPY_MIN_DISK_KB (default 5000000 = 5 GB) is available,
# the gate fails with an operational message pointing at the reaper script
# (cargo-target-reaper.sh) before wasting time on a doomed cargo invocation.
#
# Bypass (rare):
#   CHUMP_CLIPPY_GATE=0 git push
#   Emits kind=lint_bypass to ambient.jsonl; requires 'Lint-Gate-Bypass: <reason>'
#   trailer in HEAD commit body.  Use when the clippy error is a known
#   upstream regression or when running in lint-deluge state
#   (ambient kind=lint_deluge present in last 10m):
#     CHUMP_LINT_GATE=off git push   (bypass-of-bypass, deluge mode only)
# -----------------------------------------------------------------------
if [[ "${CHUMP_LINT_GATE:-on}" == "off" ]]; then
    echo "[pre-push] CHUMP_LINT_GATE=off — skipping clippy lint gate (lint-deluge mode)" >&2
elif [[ "${CHUMP_CLIPPY_GATE:-1}" == "0" ]]; then
    # Emit lint_bypass telemetry.
    _lg_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    _lg_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    _lg_gap="$(echo "$_lg_branch" | grep -oiE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]' || echo "")"
    _lg_reason="$(git log -1 --pretty=format:%B 2>/dev/null \
        | grep -i '^Lint-Gate-Bypass:' | head -1 \
        | sed 's/^[Ll]int-[Gg]ate-[Bb]ypass:[[:space:]]*//' || echo "")"
    printf '{"ts":"%s","kind":"lint_bypass","gap_id":"%s","reason":"%s","branch":"%s","bypassed_by":"CHUMP_CLIPPY_GATE=0"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_lg_gap" "$_lg_reason" "$_lg_branch" \
        >> "${_lg_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
    unset _lg_root _lg_branch _lg_gap _lg_reason
elif [[ "${CHUMP_BOT_MERGE_IN_PROGRESS:-0}" == "1" ]]; then
    # INFRA-3524: skip the clippy re-run when the push is bot-merge-initiated.
    # bot-merge already runs `cargo clippy --workspace --fix` as its own gate
    # before pushing, and CI re-runs clippy authoritatively on the PR. Re-running
    # clippy here is pure redundancy — and a cold compile in .cargo-test-target
    # (rebuilding ring's C-assembly, etc.) regularly blows bot-merge's 300s
    # push-phase budget (INFRA-2426), which SIGTERMs the push mid-flight and
    # orphans the worktree (→ META-156 re-claim failure; timed out CREDIBLE-178
    # twice). This extends INFRA-3521's preflight-skip to the clippy gate.
    # Direct (non-bot-merge) `git push` still runs the full clippy gate below.
    echo "[pre-push] INFRA-3524: skipping clippy re-run — bot-merge already clippy-checked this push; CI is authoritative." >&2
    _amb_3524="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.chump-locks/ambient.jsonl"
    printf '{"ts":"%s","kind":"prepush_clippy_skipped_botmerge","reason":"INFRA-3524: bot-merge already clippy-checked + CI authoritative"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$_amb_3524" 2>/dev/null || true
    unset _amb_3524
elif command -v cargo &>/dev/null; then
    # Determine if any .rs files changed in the push vs origin/main.
    _CLIPPY_HAS_RS=0
    if git fetch origin main --quiet 2>/dev/null; then
        if git diff --name-only origin/main...HEAD 2>/dev/null | grep -qE '\.rs$'; then
            _CLIPPY_HAS_RS=1
        fi
    else
        # Offline — check working tree diff.
        if git diff --name-only HEAD 2>/dev/null | grep -qE '\.rs$'; then
            _CLIPPY_HAS_RS=1
        fi
    fi

    if [[ "$_CLIPPY_HAS_RS" == "1" ]]; then
        # Disk-pressure check before invoking cargo.
        _CLIPPY_MIN_KB="${CHUMP_CLIPPY_MIN_DISK_KB:-5000000}"
        _AVAIL_KB=0
        if command -v df &>/dev/null; then
            # macOS: df -k . → 512-byte blocks; use df -k for kB
            _AVAIL_KB=$(df -k . 2>/dev/null | awk 'NR==2{print $4}' || echo 0)
        fi
        if [[ "$_AVAIL_KB" -lt "$_CLIPPY_MIN_KB" ]] 2>/dev/null; then
            echo "" >&2
            echo "[pre-push] BLOCKED: disk pressure — only ${_AVAIL_KB}KB available, need ${_CLIPPY_MIN_KB}KB for clippy." >&2
            echo "[pre-push] Run the cargo-target reaper to free space:" >&2
            echo "[pre-push]   bash scripts/dev/cargo-target-reaper.sh" >&2
            echo "[pre-push] Or bypass after freeing space: CHUMP_CLIPPY_GATE=0 git push" >&2
            echo "" >&2
            exit 1
        fi

        REPO_ROOT_CL="$(git rev-parse --show-toplevel)"
        echo "[pre-push] INFRA-1390: running cargo clippy (diff has .rs changes)..." >&2
        echo "[pre-push] Bypass: CHUMP_CLIPPY_GATE=0 git push  (with Lint-Gate-Bypass: trailer)" >&2

        # RESILIENT-1448: reuse a persistent, WARM target dir for the clippy
        # gate instead of a COLD per-worktree .cargo-test-target rebuilt from
        # scratch on every push. A cold full `cargo clippy --all-targets` runs
        # 10min+ on a small box (measured 920s cold vs 130s warm) -> push/phase
        # timeout -> the branch never reaches origin and no PR is created
        # (INFRA-2183 cold-per-worktree-target class). Precedence:
        #   1. CHUMP_PREPUSH_CLIPPY_TARGET_DIR - explicit override.
        #   2. inherited CARGO_TARGET_DIR - the persistent shared build cache
        #      the dispatch worker already exports (scripts/dispatch/worker.sh,
        #      INFRA-1933) and has just built `cargo check/clippy --workspace`
        #      into, so clippy here is INCREMENTAL. That dir sits outside every
        #      cargo-target-reaper scan path, so reuse is reap-safe.
        #   3. a persistent per-worker fallback under ~/.cache, keyed by worker
        #      id so parallel workers never share one dir; survives across
        #      worktrees/cycles - NOT the old cold in-worktree path.
        # Correctness is preserved: cargo recompiles on any real source change
        # regardless of which target dir it reuses, so clippy still lints the
        # true working tree and `-D warnings` still gates (warmth only, never a
        # skipped check). CI re-runs `clippy --workspace --all-targets` at merge.
        if [[ -n "${CHUMP_PREPUSH_CLIPPY_TARGET_DIR:-}" ]]; then
            _WT_CLIPPY_TARGET="$CHUMP_PREPUSH_CLIPPY_TARGET_DIR"
        elif [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
            _WT_CLIPPY_TARGET="$CARGO_TARGET_DIR"
        else
            _clippy_worker_id="${CHUMP_CLIPPY_WORKER_ID:-${WORKER_MACHINE:-host}-${AGENT_ID:-0}}"
            _WT_CLIPPY_TARGET="${XDG_CACHE_HOME:-$HOME/.cache}/chump-fleet-target/clippy-${_clippy_worker_id}"
        fi
        mkdir -p "$_WT_CLIPPY_TARGET" 2>/dev/null || true

        # Run clippy; capture exit code.
        # INFRA-5126: per-phase timeout via _pp_run_timed — wrapped in
        # `bash -c` (positional args, not string interpolation) so the cd +
        # env-var invocation still runs under `timeout`.
        if ! _pp_run_timed clippy bash -c \
            'cd "$0" && CARGO_TARGET_DIR="$1" cargo clippy --all-targets --quiet -- -D warnings' \
            "$REPO_ROOT_CL" "$_WT_CLIPPY_TARGET" 2>&1; then
            echo "" >&2
            echo "[pre-push] BLOCKED: cargo clippy -D warnings failed (INFRA-1390)." >&2
            echo "[pre-push] Lint errors must be fixed before pushing — CI will reject them." >&2
            echo "[pre-push] Fix: cargo clippy --all-targets -- -D warnings  # then git add -u && git commit --amend" >&2
            echo "" >&2
            echo "[pre-push] Bypass (rare — lint infra broken, known upstream regression):" >&2
            echo "[pre-push]   CHUMP_CLIPPY_GATE=0 git push" >&2
            echo "[pre-push]   Add 'Lint-Gate-Bypass: <reason>' to HEAD commit body." >&2
            echo "" >&2
            exit 1
        fi
        echo "[pre-push] INFRA-1390: ✓ clippy clean" >&2
    fi
fi

# -----------------------------------------------------------------------
# Guard 0b: cargo-test full-suite gate (INFRA-761)
#
# Pre-push runs `cargo test --bin chump --tests --no-fail-fast --quiet`
# when the push contains any .rs file change. Catches the "I ran scoped
# tests locally and it passed" failure mode (e.g. EVAL-026 #1349 author
# updated env_flags.rs test but missed neuromodulation.rs:340 — full
# suite would have caught it before push).
#
# Cost mitigation:
#   1. SKIP when no .rs files changed in the push range (docs-only / sh-only)
#   2. CACHE result keyed on tree-hash; re-push of same tree → skip
#   3. AUTO-SKIP on rebase (INFRA-368 detection — same code, just moved)
#
# Bypass: CHUMP_TEST_GATE=0 git push
#   When bypassing for a real reason (test infra broken, local-only spike),
#   include `Test-Gate-Bypass: <reason>` in the HEAD commit body so the
#   operator audit log can grep the trailer.
#
# Performance budget: 4–6 min on a clean target/. Cached re-runs are <1s.
# -----------------------------------------------------------------------

# RESILIENT-014: emit ambient audit event when the test gate is bypassed.
if [[ "${CHUMP_TEST_GATE:-1}" == "0" ]]; then
    _r014_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    _r014_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    _r014_gap="$(echo "$_r014_branch" | grep -oiE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]' || echo "")"
    _r014_reason="$(git log -1 --pretty=format:%B 2>/dev/null \
        | grep -i '^Test-Gate-Bypass:' | head -1 \
        | sed 's/^[Tt]est-[Gg]ate-[Bb]ypass:[[:space:]]*//' || echo "")"
    _r014_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    mkdir -p "${_r014_root}/.chump-locks" 2>/dev/null || true
    printf '{"ts":"%s","kind":"test_gate_bypassed","gap_id":"%s","reason":"%s","branch":"%s","bypassed_by":"CHUMP_TEST_GATE=0"}\n' \
        "$_r014_ts" "$_r014_gap" "$_r014_reason" "$_r014_branch" \
        >> "${_r014_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
    unset _r014_root _r014_branch _r014_gap _r014_reason _r014_ts
fi

if [[ "${CHUMP_TEST_GATE:-1}" != "0" ]] && command -v cargo &>/dev/null; then
    REPO_ROOT_T="$(git rev-parse --show-toplevel)"
    CACHE_DIR="$REPO_ROOT_T/.chump-locks/test-gate-cache"
    TREE_SHA="$(git rev-parse HEAD^{tree} 2>/dev/null || echo unknown)"
    CACHE_MARKER="$CACHE_DIR/${TREE_SHA}.ok"

    # Fast cache hit: this exact tree was tested green before.
    if [[ -f "$CACHE_MARKER" ]]; then
        # Silent on cache hit — keeps the happy-path quiet.
        :
    elif detect_recent_rebase 2>/dev/null; then
        # Rebase auto-skip: same code, was tested when first pushed.
        :
    else
        # Determine whether any .rs file changed in the push range. We read
        # stdin (the standard pre-push protocol: lines of
        # "<local_ref> <local_sha> <remote_ref> <remote_sha>"). If stdin is
        # already consumed by a later guard, fall back to the diff against
        # origin/main for a robust default.
        ANY_RS=0
        if [[ -t 0 ]] || [[ -z "${CHUMP_TEST_GATE_RANGE:-}" ]]; then
            # Stdin is a terminal or unset — use origin/main fallback.
            if git fetch origin main --quiet 2>/dev/null; then
                if git diff --name-only origin/main...HEAD 2>/dev/null \
                    | grep -qE '\.rs$'; then
                    ANY_RS=1
                fi
            else
                # Offline or no main — assume Rust changed (be conservative).
                ANY_RS=1
            fi
        fi

        if [[ "$ANY_RS" == "1" ]]; then
            # CREDIBLE-278: cargo test threads all tests in one process, so
            # tests that touch process-global env (e.g. CHUMP_REPO) race each
            # other and false-red locally on a tree CI proves green — CI runs
            # cargo-nextest, which gives every test its own process. Match CI
            # here: prefer nextest, and fail LOUD (never silent) when absent.
            _TEST_RUNNER_CMD=()
            if command -v cargo-nextest &>/dev/null; then
                echo "[pre-push] CREDIBLE-278: running cargo nextest run --bin chump --tests (full suite; process-isolated, matches CI)..." >&2
                _TEST_RUNNER_CMD=(cargo nextest run --bin chump --tests --no-fail-fast)
            else
                echo "[pre-push] WARN CREDIBLE-278: cargo-nextest not found on PATH — falling back to 'cargo test'." >&2
                echo "[pre-push] WARN CREDIBLE-278: cargo test THREADS tests in one process and can false-red on env races that nextest (CI's runner) does not hit." >&2
                echo "[pre-push] WARN CREDIBLE-278: install for a gate that matches CI: cargo install cargo-nextest --locked" >&2
                _TEST_RUNNER_CMD=(cargo test --bin chump --tests --no-fail-fast --quiet)
            fi
            echo "[pre-push] (one-time per tree-hash; cached at $CACHE_MARKER on green)" >&2
            echo "[pre-push] Bypass: CHUMP_TEST_GATE=0 git push  (with Test-Gate-Bypass: trailer)" >&2

            # Unset bot-dispatch git identity so test-spawned git ops
            # don't inherit chump-dispatch@chump.bot (INFRA-813).
            unset GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL GIT_AUTHOR_NAME GIT_COMMITTER_NAME

            # INFRA-1372 AC-2: unset GIT_DIR and friends so cargo test's child git
            # processes don't inherit the pre-push hook's GIT_DIR (which points at
            # the hook-invoking repo). Without this, Rust tests that call
            # Command::new("git") create commits inside the WRONG repo (the hook's
            # repo), not the temp fixture repo the test set up — producing empty
            # "init" commits in the real worktree's git history.
            unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

            # INFRA-1372 AC-3: record HEAD before cargo test. If a Rust test
            # creates a commit (e.g. via git-command inheritance), HEAD moves and
            # we must abort the push to prevent garbage commits landing on the branch.
            _PRE_TEST_HEAD="$(git rev-parse HEAD 2>/dev/null || echo "unknown")"

            # INFRA-1167: build --skip list from KNOWN_FLAKES.yaml so environment-
            # dependent parallel-test races never block a legitimate push. Skipped
            # tests are announced upfront; CHUMP_TEST_GATE=0 remains emergency bypass.
            _SKIP_ARGS=()
            _CATALOG="$REPO_ROOT_T/docs/process/KNOWN_FLAKES.yaml"
            if [[ -f "$_CATALOG" ]]; then
                while IFS= read -r _tname; do
                    [[ -z "$_tname" ]] && continue
                    # Warn if entry lacks a tracking_gap (discipline check, AC 6).
                    if ! grep -A5 "test: ${_tname}" "$_CATALOG" 2>/dev/null \
                            | grep -q "tracking_gap:"; then
                        echo "[pre-push] WARN: KNOWN_FLAKES entry '${_tname}' has no tracking_gap — add one (INFRA-764)" >&2
                    fi
                    echo "[pre-push] SKIP (known flake): ${_tname}" >&2
                    if [[ "${#_SKIP_ARGS[@]}" -eq 0 ]]; then
                        _SKIP_ARGS+=("--")
                    fi
                    _SKIP_ARGS+=("--skip" "${_tname}")
                done < <(grep -E '^[[:space:]]*-[[:space:]]*test:' "$_CATALOG" \
                    | sed -E 's/^[[:space:]]*-[[:space:]]*test:[[:space:]]+//; s/"//g; s/[[:space:]]*$//')
            fi

            # RESILIENT-012: capture test output to temp file so we can parse
            # failing test names against KNOWN_FLAKES.yaml for auto-bypass.
            _TEST_LOG="$(mktemp -t pre-push-test.XXXXXX)"
            # shellcheck disable=SC2064
            trap "rm -f '$_TEST_LOG'" EXIT

            # --no-fail-fast so we surface the full failure list, not just first.
            # --quiet trims the per-test PASS lines but keeps FAILED lines.
            # RESILIENT-009: cd to REPO_ROOT_T so cargo test runs in the linked
            # worktree, not the invoking shell's cwd (main checkout). Without this,
            # GIT_DIR overrides cause tests to run against main's source tree even
            # when pushing from a linked worktree.
            # INFRA-1138: use per-worktree target directory for the test run to
            # prevent phantom fingerprint contamination from sibling worktrees that
            # share the same CARGO_TARGET_DIR (set by install-sccache.sh / INFRA-481).
            # The shared sccache (via rustc-wrapper in .cargo/config.toml) still
            # provides cross-worktree object-code caching; only fingerprints are
            # isolated. Per-worktree path ensures each linked worktree's test run
            # sees only its own source file set.
            _WT_TEST_TARGET="$REPO_ROOT_T/.cargo-test-target"
            # INFRA-1316: bash 3.2 + `set -u` aborts on `"${arr[@]}"` when
            # the array is empty. KNOWN_FLAKES.yaml has zero entries today,
            # so the subshell crashed before cargo test ever ran and the
            # hook falsely reported "tests failed" on every push.
            #
            # `${arr[@]:+"${arr[@]}"}` is the canonical safe idiom: it
            # expands to the array contents iff set-and-non-empty, otherwise
            # to nothing (zero args, not one empty arg — important because
            # cargo test treats `""` as a filter and silently runs zero tests).
            # INFRA-1403: prefer cargo-test-with-rerun.sh when available; it handles
            # KNOWN_FLAKES auto-rerun and structured ambient telemetry internally,
            # superseding the RESILIENT-012 manual bypass logic in the fallback path.
            # INFRA-1744: timeout-wrap the test invocation. Multiple worktrees
            # pushing concurrently produced 30+min cargo test hangs (sccache
            # / fingerprint contention). Without a bound, every sibling stalls
            # the entire fleet. 10 min is well above warm-cache full suite
            # (~3-5 min observed) but below the indefinite-hang failure mode.
            _PREPUSH_TEST_TIMEOUT_S="${CHUMP_PREPUSH_TEST_TIMEOUT_S:-600}"
            _RERUN_SCRIPT="$REPO_ROOT_T/scripts/ci/cargo-test-with-rerun.sh"

            # INFRA-2184: probe the configured RUSTC_WRAPPER (typically sccache,
            # set in .cargo/config.toml). If the binary is missing or fails
            # --version, clear CARGO_BUILD_RUSTC_WRAPPER for the cargo test
            # invocation so a host-level sccache breakage (the binary that
            # actually shells out to rustc returns ENOENT mid-build) does NOT
            # block every push across the fleet. Cargo's env CARGO_BUILD_*
            # overrides the [build] section in config.toml.
            _PREPUSH_WRAPPER_OVERRIDE=()
            _PREPUSH_WRAPPER_BIN="${RUSTC_WRAPPER:-$(awk -F\" '/^[[:space:]]*rustc-wrapper[[:space:]]*=/ {print $2; exit}' "$REPO_ROOT_T/.cargo/config.toml" 2>/dev/null)}"
            if [[ -n "$_PREPUSH_WRAPPER_BIN" ]]; then
                # EFFECTIVE-097: HEAL, don't just probe. The old INFRA-2184 check ran
                # `$WRAPPER --version`, but for sccache that is a CLIENT-only call that
                # succeeds even when the compile SERVER is dead (the recurring
                # "0 compile requests / os error 2 / never executed" failure). So the
                # probe passed, cargo used the dead wrapper, every Rust push false-failed,
                # and the whole fleet learned to reach for CHUMP_TEST_GATE=0. Instead:
                #   1. `--start-server` is an idempotent HEAL (starts a dead server; it
                #      exits 2 when one is already running, so its exit is intentionally
                #      ignored — never used as the liveness signal).
                #   2. `--show-stats` is the real liveness check: it returns 0 iff the
                #      server responds (true both when it was already up and after a heal).
                # Only when the binary is missing, OR cannot be healed AND fails --version
                # (a non-sccache wrapper), do we disable the wrapper — gate still runs,
                # just without caching (slow but a TRUE signal, never a false fail).
                if [[ ! -x "$_PREPUSH_WRAPPER_BIN" ]]; then
                    echo "[pre-push] EFFECTIVE-097: RUSTC_WRAPPER ($_PREPUSH_WRAPPER_BIN) not executable — disabling wrapper for test gate (push proceeds without sccache caching)." >&2
                    _PREPUSH_WRAPPER_OVERRIDE=(env CARGO_BUILD_RUSTC_WRAPPER= RUSTC_WRAPPER=)
                else
                    "$_PREPUSH_WRAPPER_BIN" --start-server >/dev/null 2>&1 || true  # idempotent heal; exit ignored (2 == already running)
                    if "$_PREPUSH_WRAPPER_BIN" --show-stats >/dev/null 2>&1; then
                        : # server live (was up, or just healed) — keep the wrapper, gate runs cached
                    elif "$_PREPUSH_WRAPPER_BIN" --version >/dev/null 2>&1; then
                        : # non-sccache wrapper without --show-stats but responsive — trust it as before
                    else
                        echo "[pre-push] EFFECTIVE-097: RUSTC_WRAPPER ($_PREPUSH_WRAPPER_BIN) server could not start and is unresponsive — disabling wrapper for test gate (push proceeds without sccache caching; true signal preserved)." >&2
                        _PREPUSH_WRAPPER_OVERRIDE=(env CARGO_BUILD_RUSTC_WRAPPER= RUSTC_WRAPPER=)
                    fi
                fi
            fi

            if [[ -x "$_RERUN_SCRIPT" ]]; then
                if (cd "$REPO_ROOT_T" && CARGO_TARGET_DIR="$_WT_TEST_TARGET" \
                    ${_PREPUSH_WRAPPER_OVERRIDE[@]:+"${_PREPUSH_WRAPPER_OVERRIDE[@]}"} \
                    timeout "${_PREPUSH_TEST_TIMEOUT_S}s" \
                    bash "$_RERUN_SCRIPT" -- \
                        "${_TEST_RUNNER_CMD[@]}" \
                        ${_SKIP_ARGS[@]:+"${_SKIP_ARGS[@]}"}); then
                    mkdir -p "$CACHE_DIR"
                    date -u +%Y-%m-%dT%H:%M:%SZ > "$CACHE_MARKER"
                    echo "[pre-push] INFRA-761: ✓ full suite green; cached for tree $TREE_SHA" >&2
                else
                    _rc=$?
                    # INFRA-1744: rc=124 from `timeout` = exceeded budget; emit
                    # structured ambient event and give the operator a specific
                    # diagnostic (worktree contention) vs generic test failure.
                    if [[ $_rc -eq 124 ]]; then
                        _amb="${CHUMP_AMBIENT_LOG:-$REPO_ROOT_T/.chump-locks/ambient.jsonl}"
                        mkdir -p "$(dirname "$_amb")" 2>/dev/null || true
                        printf '{"ts":"%s","kind":"prepush_test_timeout","worktree":"%s","timeout_s":%s}\n' \
                            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                            "$REPO_ROOT_T" "$_PREPUSH_TEST_TIMEOUT_S" \
                            >> "$_amb" 2>/dev/null || true
                        echo "" >&2
                        echo "[pre-push] BLOCKED: cargo test exceeded ${_PREPUSH_TEST_TIMEOUT_S}s (INFRA-1744)." >&2
                        echo "[pre-push] Likely worktree contention — multiple sibling pushes share sccache/target." >&2
                        echo "[pre-push] Try again with: CHUMP_TEST_GATE=0 git push  (with 'Test-Gate-Bypass: timeout-under-contention' trailer)" >&2
                        echo "[pre-push] OR raise the budget: CHUMP_PREPUSH_TEST_TIMEOUT_S=1200 git push" >&2
                        echo "" >&2
                        exit 1
                    fi
                    echo "" >&2
                    echo "[pre-push] BLOCKED: test suite failed after flake auto-rerun (INFRA-761/1403)." >&2
                    echo "[pre-push] Classify new flakes in docs/process/KNOWN_FLAKES.yaml (see INFRA-764)." >&2
                    echo "[pre-push] Bypass (rare): CHUMP_TEST_GATE=0 git push" >&2
                    echo "[pre-push]   When bypassing, include 'Test-Gate-Bypass: <reason>' in" >&2
                    echo "[pre-push]   the HEAD commit body so the audit log can find the trailer." >&2
                    echo "" >&2
                    exit 1
                fi
            else
                # Fallback (RESILIENT-012): direct cargo test with post-failure parse
                # against KNOWN_FLAKES.yaml for auto-bypass when wrapper is absent.
                # INFRA-1744: same timeout protection as the rerun-script path above.
                # INFRA-2184: same sccache liveness override as the rerun path.
                if (cd "$REPO_ROOT_T" && CARGO_TARGET_DIR="$_WT_TEST_TARGET" \
                    ${_PREPUSH_WRAPPER_OVERRIDE[@]:+"${_PREPUSH_WRAPPER_OVERRIDE[@]}"} \
                    timeout "${_PREPUSH_TEST_TIMEOUT_S}s" \
                    "${_TEST_RUNNER_CMD[@]}" \
                        ${_SKIP_ARGS[@]:+"${_SKIP_ARGS[@]}"}) 2>&1 \
                    | tee "$_TEST_LOG" | tail -200; then
                    mkdir -p "$CACHE_DIR"
                    date -u +%Y-%m-%dT%H:%M:%SZ > "$CACHE_MARKER"
                    echo "[pre-push] INFRA-761: ✓ full suite green; cached for tree $TREE_SHA" >&2
                else
                    # RESILIENT-012: auto-bypass if ALL failing tests are in KNOWN_FLAKES.yaml.
                    # Prevents manual Test-Gate-Bypass trailers for pre-existing main failures.
                    _CATALOG="$REPO_ROOT_T/docs/process/KNOWN_FLAKES.yaml"
                    # `|| true` defuses `set -e + pipefail`: when grep finds
                    # zero "test FOO ... FAILED" lines (compile error, panic,
                    # mock-cargo failure, etc.), the pipeline exits 1 and
                    # aborts the hook BEFORE the BLOCKED diagnostic can fire.
                    _FAILED=$(grep -E '^test [A-Za-z_][A-Za-z0-9_:]+ \.\.\. FAILED' "$_TEST_LOG" \
                        | sed -E 's/^test ([A-Za-z_][A-Za-z0-9_:]+) .*/\1/' \
                        | sort -u || true)
                    _ALL_KNOWN=1
                    _UNKNOWN_TESTS=()
                    if [[ -n "$_FAILED" && -f "$_CATALOG" ]]; then
                        _CATALOG_TESTS=$(grep -E '^[[:space:]]*-[[:space:]]*test:' "$_CATALOG" \
                            | sed -E 's/^[[:space:]]*-[[:space:]]*test:[[:space:]]+//; s/"//g; s/[[:space:]]*$//')
                        # INFRA-1658: materialize to tempfile to dodge printf|grep -q
                        # pipefail race (set -o pipefail is in effect).
                        _CAT_TMP=$(mktemp)
                        printf '%s\n' "$_CATALOG_TESTS" > "$_CAT_TMP"
                        while IFS= read -r _tname; do
                            [[ -z "$_tname" ]] && continue
                            if ! grep -qxF "$_tname" "$_CAT_TMP"; then
                                _ALL_KNOWN=0
                                _UNKNOWN_TESTS+=("$_tname")
                            fi
                        done <<< "$_FAILED"
                        rm -f "$_CAT_TMP"
                    else
                        # No parseable failures (compile error?) or no catalog — treat as real failure.
                        _ALL_KNOWN=0
                    fi

                    if [[ "$_ALL_KNOWN" -eq 1 && -n "$_FAILED" ]]; then
                        _FAILED_LIST=$(printf '%s\n' "$_FAILED" | tr '\n' ' ')
                        echo "" >&2
                        echo "[pre-push] RESILIENT-012: all failures are catalogued in KNOWN_FLAKES.yaml — auto-bypassing gate" >&2
                        echo "[pre-push] Known flakes: $_FAILED_LIST" >&2
                        echo "[pre-push] (no Test-Gate-Bypass trailer needed; these are pre-existing main failures)" >&2
                        mkdir -p "$CACHE_DIR"
                        date -u +%Y-%m-%dT%H:%M:%SZ > "$CACHE_MARKER"
                    else
                        echo "" >&2
                        echo "[pre-push] BLOCKED: cargo test --bin chump --tests failed (INFRA-761)." >&2
                        echo "[pre-push] Full-suite test failure cannot be pushed — CI would reject." >&2
                        if [[ "${#_UNKNOWN_TESTS[@]}" -gt 0 ]]; then
                            echo "[pre-push] Unknown failures (not in KNOWN_FLAKES.yaml):" >&2
                            for _t in "${_UNKNOWN_TESTS[@]}"; do
                                echo "[pre-push]   $_t" >&2
                            done
                        fi
                        echo "" >&2
                        echo "[pre-push] If this is a known pre-existing flake, classify it via" >&2
                        echo "[pre-push]   docs/process/KNOWN_FLAKES.yaml (see INFRA-764) and rerun." >&2
                        echo "[pre-push] Bypass (rare): CHUMP_TEST_GATE=0 git push" >&2
                        echo "[pre-push]   When bypassing, include 'Test-Gate-Bypass: <reason>' in" >&2
                        echo "[pre-push]   the HEAD commit body so the audit log can find the trailer." >&2
                        echo "" >&2
                        exit 1
                    fi
                fi
            fi  # end if [[ -x "$_RERUN_SCRIPT" ]]
        else
            # INFRA-1403: no .rs changes in this push — skip test gate and emit telemetry.
            _AMBIENT_LOG="$REPO_ROOT_T/.chump-locks/ambient.jsonl"
            _BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
            mkdir -p "$(dirname "$_AMBIENT_LOG")" 2>/dev/null || true
            printf '{"ts":"%s","event":"INFO","kind":"pre_push_test_gate_skipped","reason":"no_rust_changes","branch":"%s","source":"pre-push"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_BRANCH" \
                >> "$_AMBIENT_LOG" 2>/dev/null || true
            echo "[pre-push] INFRA-1403: no .rs changes — test gate skipped." >&2
        fi  # end if [[ "$ANY_RS" == "1" ]]
    fi

    # INFRA-1372 AC-3: HEAD-drift detection — abort push if cargo test created
    # a commit. GIT_DIR is now restored (unset above then re-exported after the
    # subshell exits — bash restores env after a subshell, but `unset` in the
    # parent shell is permanent). We re-read HEAD here from the worktree gitdir.
    if [[ "${_PRE_TEST_HEAD:-unknown}" != "unknown" ]]; then
        _POST_TEST_HEAD="$(git rev-parse HEAD 2>/dev/null || echo "unknown")"
        if [[ "$_PRE_TEST_HEAD" != "$_POST_TEST_HEAD" && "$_POST_TEST_HEAD" != "unknown" ]]; then
            _pp_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
            _pp_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
            _pp_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            mkdir -p "${_pp_root}/.chump-locks" 2>/dev/null || true
            printf '{"ts":"%s","kind":"prepush_head_drift","pre_head":"%s","post_head":"%s","branch":"%s"}\n' \
                "$_pp_ts" "$_PRE_TEST_HEAD" "$_POST_TEST_HEAD" "$_pp_branch" \
                >> "${_pp_root}/.chump-locks/ambient.jsonl" 2>/dev/null || true
            echo "" >&2
            echo "[pre-push] BLOCKED (INFRA-1372): HEAD moved during cargo test run!" >&2
            echo "[pre-push]   Before: $_PRE_TEST_HEAD" >&2
            echo "[pre-push]   After:  $_POST_TEST_HEAD" >&2
            echo "[pre-push] A test created a git commit — this leaks garbage commits onto the branch." >&2
            echo "[pre-push] Fix: ensure every Command::new(git) in tests unsets GIT_DIR/GIT_WORK_TREE." >&2
            echo "[pre-push] Emitted kind=prepush_head_drift to ambient.jsonl for observability." >&2
            echo "" >&2
            exit 1
        fi
    fi
fi

# INFRA-368: detect a legitimate rebase force-push so Guards 1+2 silently
# auto-skip (Guard 3 still runs — race protection applies regardless).
#
# Heuristic: git's reflog records "rebase (start)/(finish)" for both
# `git rebase` and `git pull --rebase`. If we see one within the last
# REBASE_DETECT_WINDOW_S seconds, treat the push as a rebase finalization.
# Bypass: CHUMP_REBASE_DETECT=0 to disable detection (force the guards on).
#
# Why skip Guard 2 (auto-merge armed) on rebase: the canonical recovery
# pattern for a DIRTY-after-arm PR is exactly "rebase + force-push" — the
# guard treats every push-after-arm as the PR #52 footgun, which it isn't
# when the diff is unchanged and only the parent commit moved.
# Why skip Guard 1 (gap-preflight) on rebase: same gap IDs in commits;
# preflight already ran when the original push went out.
# Why KEEP Guard 3 (force-with-lease race): a sibling can still push
# between your fetch+rebase and your force-push — that's what Guard 3
# catches, regardless of whether your push is a rebase or a rewrite.
detect_recent_rebase() {
    [[ "${CHUMP_REBASE_DETECT:-1}" == "0" ]] && return 1
    local window_s="${REBASE_DETECT_WINDOW_S:-300}"  # 5 min default
    # `git reflog show HEAD --since=...` doesn't filter by message; manually
    # check the last 50 entries for a "rebase" message within the window.
    # Format: "<sha> HEAD@{<idx>}: <message>" — use --date=unix on @{...}
    # via a separate parse since reflog --date= prints the AUTHOR date,
    # not the reflog-entry date. Use git reflog --date=iso-local instead.
    local now last_ts
    now=$(date +%s)
    while IFS=$'\t' read -r ts_str msg; do
        [[ "$msg" == *"rebase"* ]] || continue
        # ts_str format: "Mon May  3 12:34:56 2026"; convert via date -j -f
        last_ts=$(date -j -f '%a %b %e %H:%M:%S %Y' "$ts_str" '+%s' 2>/dev/null \
                  || date -d "$ts_str" '+%s' 2>/dev/null)
        [[ -z "$last_ts" ]] && continue
        if (( now - last_ts < window_s )); then
            return 0  # found a recent rebase
        fi
    done < <(git reflog show HEAD --date=local --format='%cd	%gs' -50 2>/dev/null)
    return 1
}

# -----------------------------------------------------------------------
# Guard 6: Stale-rebase staleness gate (INFRA-2628)
#
# Reproducer 2026-06-03: Sonnet worktree provisioned when origin/main was
# at ~56e15def. After 30 min of work, PR #2987 (INFRA-2524) landed, moving
# main to 31e71d16 and adding a 66-line gate_name_is_plausible() function.
# The diff at push time showed -66 lines — a stale-base branch would have
# rescinded the just-landed safety guard. The orchestrator caught it
# manually via `git rebase origin/main`. This guard automates that catch.
#
# For any chump/<gap-id>-* branch push, if origin/main has moved more than
# CHUMP_STALE_REBASE_MAX_BEHIND commits past the branch's merge-base, the
# push is refused with a clear rebase directive.
#
# Override (increase limit, not disable): CHUMP_STALE_REBASE_MAX_BEHIND=999
# Bypass intent is communicated via the =999 tunable, not a separate flag.
# -----------------------------------------------------------------------
_srb_current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
if [[ "$_srb_current_branch" =~ ^chump/[a-zA-Z]+-[0-9]+ ]]; then
    # Fetch origin/main so the staleness count is against actual remote state.
    git fetch origin main --quiet 2>/dev/null || true
    _srb_max_behind="${CHUMP_STALE_REBASE_MAX_BEHIND:-5}"
    _srb_merge_base="$(git merge-base origin/main HEAD 2>/dev/null || echo "")"
    if [[ -n "$_srb_merge_base" ]]; then
        _srb_commits_behind="$(git rev-list --count "${_srb_merge_base}..origin/main" 2>/dev/null || echo 0)"
        _srb_current_main_head="$(git rev-parse --short origin/main 2>/dev/null || echo unknown)"
        if [[ "$_srb_commits_behind" -gt "$_srb_max_behind" ]]; then
            echo "" >&2
            echo "[pre-push] BLOCKED: branch is ${_srb_commits_behind} commits behind origin/main since last rebase." >&2
            echo "[pre-push] Rebase risk: stale-base may rescind recently-landed changes (INFRA-2628 reproducer 2026-06-03)." >&2
            echo "[pre-push] Fix: cd <worktree> && git rebase origin/main && verify diff before push." >&2
            echo "[pre-push] Override: CHUMP_STALE_REBASE_MAX_BEHIND=999 git push  (audit-logged)" >&2
            echo "" >&2
            # scanner-anchor: "kind":"stale_rebase_blocked"
            _srb_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
            _wt_list_srb="$(git worktree list --porcelain 2>/dev/null || true)"
            _main_repo_srb="$(awk '/^worktree / {print $2; exit}' <<<"$_wt_list_srb")"
            unset _wt_list_srb
            [[ -n "$_main_repo_srb" && -d "$_main_repo_srb/.chump-locks" ]] && _srb_root="$_main_repo_srb"
            unset _main_repo_srb
            _srb_ambient="${CHUMP_AMBIENT_LOG:-$_srb_root/.chump-locks/ambient.jsonl}"
            mkdir -p "$(dirname "$_srb_ambient")" 2>/dev/null || true
            printf '{"ts":"%s","kind":"stale_rebase_blocked","branch":"%s","commits_behind":%d,"merge_base":"%s","current_main_head":"%s"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                "$_srb_current_branch" \
                "$_srb_commits_behind" \
                "$_srb_merge_base" \
                "$_srb_current_main_head" \
                >> "$_srb_ambient" 2>/dev/null || true
            unset _srb_root _srb_ambient _srb_commits_behind _srb_merge_base _srb_max_behind \
                  _srb_current_branch _srb_current_main_head
            exit 1
        fi
    fi
fi
unset _srb_current_branch _srb_max_behind _srb_merge_base _srb_commits_behind \
      _srb_current_main_head 2>/dev/null || true

# Read the list of refs being pushed from stdin (format: local_ref local_sha remote_ref remote_sha)
