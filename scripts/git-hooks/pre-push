        if grep -qE '^Force-Stale-Base-Bypass:' <<<"$_fsb_head_msg"; then
            _fsb_bypass_reason="$(grep -E '^Force-Stale-Base-Bypass:' <<<"$_fsb_head_msg" \
                | head -1 | sed -E 's/^Force-Stale-Base-Bypass:[[:space:]]*//')"
            _fsb_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
            _fsb_wt_list="$(git worktree list --porcelain 2>/dev/null || true)"
            _fsb_main_repo="$(awk '/^worktree / {print $2; exit}' <<<"$_fsb_wt_list")"
            [[ -n "$_fsb_main_repo" && -d "$_fsb_main_repo/.chump-locks" ]] && _fsb_root="$_fsb_main_repo"
            _fsb_ambient="${CHUMP_AMBIENT_LOG:-$_fsb_root/.chump-locks/ambient.jsonl}"
            mkdir -p "$(dirname "$_fsb_ambient")" 2>/dev/null || true
            printf '{"ts":"%s","kind":"stale_base_bypassed","reason":"%s"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_fsb_bypass_reason" \
                >> "$_fsb_ambient" 2>/dev/null || true
