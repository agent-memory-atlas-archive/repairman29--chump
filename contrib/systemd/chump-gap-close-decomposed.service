# RESILIENT-1366 — auto-close decomposed umbrella gaps when all child slices are done.
# One-shot service that runs chump gap close-decomposed to walk the gap store and
# close parent umbrellas whose decomposed children have all shipped.
# Typically paired with a timer for periodic execution.
[Unit]
Description=Chump gap close-decomposed — auto-close umbrellas when children are done (RESILIENT-1366)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeff
Environment=HOME=/home/jeff
Environment=PATH=/home/jeff/.cargo/bin:/home/jeff/Projects/chump/target/release:/usr/local/bin:/usr/bin:/bin
Environment=CHUMP_REPO_ROOT=/home/jeff/Projects/chump
WorkingDirectory=/home/jeff/Projects/chump
ExecStart=/bin/bash -lc 'exec chump gap close-decomposed'
TimeoutStartSec=300
