<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.chump.claude-reaper — INFRA-1662: launchd watchdog that reaps orphan
  `claude` binary subprocesses leaked by long-running autonomous loops
  (/loop, ScheduleWakeup, CronCreate). Cron 6249a56f leaked 354 wedged
  subprocesses over 60h on 2026-05-20→22.

  Runs scripts/ops/reap-orphan-claude-procs.sh every 2 minutes (120s).
  Emits kind=orphan_subprocess_reaped to ambient.jsonl on each sweep.

  INFRA-1930: cadence tightened from 300s -> 120s. At 300s, the PTY-pressure
  urgent mode (see reap-orphan-claude-procs.sh) was firing reactively —
  95 reaper_pty_pressure events/24h, i.e. the sweep kept discovering
  pressure already past the 80% threshold instead of catching it climbing.
  A tighter cadence gives the reaper more chances per hour to catch rising
  allocation before it saturates.

  INSTALLATION:
    scripts/setup/install-claude-reaper.sh

  Manual:
    1. Render the placeholders for this host (INFRA-8194; no hand edits):
    2. chump node render-unit launchd/com.chump.claude-reaper.plist --out ~/Library/LaunchAgents/com.chump.claude-reaper.plist
    3. launchctl load ~/Library/LaunchAgents/com.chump.claude-reaper.plist
    4. launchctl list | grep chump.claude-reaper      # verify
    5. launchctl start com.chump.claude-reaper        # test immediately
    6. launchctl unload ~/Library/LaunchAgents/com.chump.claude-reaper.plist  # disable

  Bypass at runtime (without unloading): export CHUMP_REAPER_DISABLED=1
  in the agent's environment, or set it on the plist EnvironmentVariables
  block below.

  LOGS:
    stdout: /tmp/chump-claude-reaper.out.log
    stderr: /tmp/chump-claude-reaper.err.log
-->
<dict>
  <key>Label</key>
  <string>com.chump.claude-reaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__REPO_ROOT__/scripts/ops/reap-orphan-claude-procs.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <!-- Run every 2 minutes (120s, INFRA-1930). Short cadence is fine: the
       script is idempotent and cheap (one ps call, in-memory walk). -->
  <key>StartInterval</key>
  <integer>120</integer>

  <!-- Guard against rapid restarts if the watchdog crashes. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <!-- Do NOT run at load — wait for the first interval. Prevents a thundering
       herd of reapers right after `launchctl load`. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-claude-reaper.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/chump-claude-reaper.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:__BREW_PREFIX__/bin:__BREW_PREFIX__/sbin</string>
  </dict>
</dict>
</plist>
