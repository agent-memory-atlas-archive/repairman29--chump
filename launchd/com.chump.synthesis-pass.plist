<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.chump.synthesis-pass — LaunchAgent for periodic synthesis passes.

  Runs scripts/dev/synthesis-pass.sh every 6 hours (21600 seconds).
  Writes output to docs/syntheses/synthesis-pass-YYYY-MM-DD-HHMM.md.

  INSTALLATION (manual — not installed automatically):
    1. Render the placeholders for this host (INFRA-8194; no hand edits):
    2. chump node render-unit launchd/com.chump.synthesis-pass.plist --out ~/Library/LaunchAgents/com.chump.synthesis-pass.plist
    3. Load the agent:
         launchctl load ~/Library/LaunchAgents/com.chump.synthesis-pass.plist
    4. Verify it loaded:
         launchctl list | grep chump.synthesis-pass
    5. To run immediately (for testing):
         launchctl start com.chump.synthesis-pass
    6. To unload:
         launchctl unload ~/Library/LaunchAgents/com.chump.synthesis-pass.plist

  LOGS:
    stdout: __REPO_ROOT__/logs/synthesis-pass.out.log
    stderr: __REPO_ROOT__/logs/synthesis-pass.err.log

  DRY RUN (test without installing):
    CHUMP_DRY_RUN=1 ./scripts/dev/synthesis-pass.sh
-->
<dict>
  <key>Label</key>
  <string>com.chump.synthesis-pass</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__REPO_ROOT__/scripts/dev/synthesis-pass.sh __REPO_ROOT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <!-- Run every 6 hours (21600 seconds). -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <!-- INFRA-819: guard against rapid restarts if synthesis-pass crashes
       (e.g. ENOSPC mid-write). 60s matches the heartbeat-watcher backoff. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <!-- Do NOT run at load — wait for the first interval to elapse. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/logs/synthesis-pass.out.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/logs/synthesis-pass.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:__BREW_PREFIX__/bin:__BREW_PREFIX__/sbin</string>
    <!-- gh CLI and git must be on PATH. Adjust if brew installs to a different prefix. -->
  </dict>
</dict>
</plist>
