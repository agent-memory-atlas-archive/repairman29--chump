<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.chump.ci-fleet-health-sweep — CREDIBLE-220 LaunchAgent.

  Runs scripts/coord/ci-fleet-health-sweep.sh once a day. Reads the fleet
  repo list from docs/arsenal/GLOBAL_ARSENAL.json, checks each repo's
  default-branch Actions CI conclusion, and files ONE gap
  (chump gap reserve --external-repo owner/repo) per repo that has been
  continuously red for >= CHUMP_CI_FLEET_SWEEP_DAYS (default 3) days —
  the gap this daemon exists to close: ai-gm-service and jarvis-rog-ed sat
  red for ~6 months, unnoticed, because nothing was watching non-chump
  fleet repos.

  INSTALLATION:
    1. Render the placeholders for this host (INFRA-8194; no hand edits):
    2. chump node render-unit launchd/com.chump.ci-fleet-health-sweep.plist --out ~/Library/LaunchAgents/com.chump.ci-fleet-health-sweep.plist
    3. launchctl load ~/Library/LaunchAgents/com.chump.ci-fleet-health-sweep.plist
    4. Verify: launchctl list | grep com.chump.ci-fleet-health-sweep
    5. Manual run: launchctl start com.chump.ci-fleet-health-sweep
       Logs: tail /tmp/chump-ci-fleet-health-sweep.out.log

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.chump.ci-fleet-health-sweep.plist
    rm ~/Library/LaunchAgents/com.chump.ci-fleet-health-sweep.plist
-->
<dict>
  <key>Label</key>
  <string>com.chump.ci-fleet-health-sweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/coord/ci-fleet-health-sweep.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <!-- Once a day (86400 seconds). Sleep-aware (skipped while laptop sleeping). -->
  <key>StartInterval</key>
  <integer>86400</integer>

  <!-- Don't start at load — wait for the first tick. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-ci-fleet-health-sweep.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/chump-ci-fleet-health-sweep.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:__BREW_PREFIX__/bin:__BREW_PREFIX__/sbin</string>
    <!-- chump, gh, git, python3 must be on PATH. -->
  </dict>

  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
