<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.chump.heartbeat-watcher — LaunchAgent for the ambient silent-agent watcher.

  Keeps scripts/dev/heartbeat-watcher.sh running as a persistent daemon.
  launchd will restart it automatically if it exits (KeepAlive true).

  INSTALLATION (manual — not auto-installed):
    1. Render the placeholders for this host (INFRA-8194; no hand edits):
    2. chump node render-unit launchd/com.chump.heartbeat-watcher.plist --out ~/Library/LaunchAgents/com.chump.heartbeat-watcher.plist
    3. Load the agent:
         launchctl load ~/Library/LaunchAgents/com.chump.heartbeat-watcher.plist
    4. Verify it loaded:
         launchctl list | grep chump.heartbeat-watcher
    5. To run immediately (for testing):
         launchctl start com.chump.heartbeat-watcher
    6. To stop and unload:
         launchctl unload ~/Library/LaunchAgents/com.chump.heartbeat-watcher.plist

  LOGS:
    daemon log:  __REPO_ROOT__/.chump-locks/.heartbeat-watcher.log
    stdout:      __REPO_ROOT__/logs/heartbeat-watcher.out.log
    stderr:      __REPO_ROOT__/logs/heartbeat-watcher.err.log

  MANUAL TEST (without installing):
    __REPO_ROOT__/scripts/dev/heartbeat-watcher.sh start
    __REPO_ROOT__/scripts/dev/heartbeat-watcher.sh status
    __REPO_ROOT__/scripts/dev/heartbeat-watcher.sh stop

  NOTE: heartbeat-watcher.sh also prevents duplicate instances via a PID file
  at .chump-locks/.heartbeat-watcher.pid. launchd's KeepAlive provides an
  additional restart layer if the process is killed externally.
-->
<dict>
  <key>Label</key>
  <string>com.chump.heartbeat-watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/dev/heartbeat-watcher.sh</string>
    <string>start</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <!-- INFRA-819: Conditional KeepAlive — restart ONLY on crash (non-zero exit),
       NOT on clean exit (e.g. disk-preflight exit-0 path on graceful stop).
       This prevents a stopped daemon from self-resurrecting unexpectedly. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <!-- Start immediately when loaded -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/logs/heartbeat-watcher.out.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/logs/heartbeat-watcher.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:__BREW_PREFIX__/bin:__BREW_PREFIX__/sbin</string>
    <!-- git must be on PATH for REPO_ROOT resolution inside the script. -->
  </dict>

  <!-- INFRA-819: Throttle restart loops — 60s between restart attempts.
       Under ENOSPC, the disk-preflight in heartbeat-watcher.sh exits 1;
       launchd waits 60s before the next attempt. Without ThrottleInterval
       (old: 10s), launchd hits crash-loop throttle and stops restarting,
       requiring a manual 'launchctl start'. 60s is short enough that the
       daemon resumes within a minute of disk recovery. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
