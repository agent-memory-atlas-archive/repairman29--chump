# Supabase self-hosted secrets for cuphead.
# Copy to /srv/supabase-data/.env and fill, OR run scripts/gen-secrets.sh to generate
# a complete .env automatically. The REAL .env is gitignored and MUST NEVER be committed.
#
# Postgres superuser password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
#
# JWT signing secret (>=32 chars). Generate: openssl rand -hex 32
# Signs the anon + service_role API keys below.
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
#
# Supabase API keys — HS256 JWTs signed with JWT_SECRET, role claim anon / service_role.
# gen-secrets.sh mints these from JWT_SECRET. Do not hand-write.
SUPABASE_ANON_KEY=REPLACE_minted_from_JWT_SECRET_role_anon
SUPABASE_SERVICE_ROLE_KEY=REPLACE_minted_from_JWT_SECRET_role_service_role
#
# Google OAuth (the one Google thing that STAYS — "Sign in with Google").
# From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=REPLACE_WITH_google_oauth_client_id
GOOGLE_CLIENT_SECRET=REPLACE_WITH_google_oauth_client_secret
#
# Studio bind address — set to cuphead's TAILNET ip so Studio is tailnet-only, never public.
STUDIO_BIND_ADDR=100.113.181.18