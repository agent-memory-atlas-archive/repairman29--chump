# Caddy reverse proxy for the self-hosted Supabase stack on cuphead.
# Auto-TLS (Let's Encrypt) on 443 — the VCN security list + host iptables allow 80/443,
# and the api.* A records point to cuphead (161.153.42.233).
# Upstreams are the container host ports (all bound to 127.0.0.1 except Studio on the tailnet):
#   PostgREST 54321 · GoTrue(auth) 9999 · Storage 5000

# Shared Supabase API routing (Kong-free): strip the Supabase path prefix, proxy per service.
(supabase_api) {
	# Kong parity: REST + Storage require an apikey (or Bearer) header. Auth is exempt
	# because OAuth redirects (/authorize, /callback, /verify) arrive from browsers without one.
	# (The check lives INSIDE each handle_path: Caddy orders handle_path before a site-level respond.)
	@nokey {
		not header apikey *
		not header Authorization *
	}
	handle_path /rest/v1/* {
		respond @nokey `{"message":"No API key found in request"}` 401
		reverse_proxy 127.0.0.1:54321
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9999
	}
	@storage_nokey {
		not header apikey *
		not header Authorization *
		not path /object/public/*
	}
	handle_path /storage/v1/* {
		respond @storage_nokey `{"message":"No API key found in request"}` 401
		reverse_proxy 127.0.0.1:5000
	}
	handle {
		respond "supabase (cuphead) - use /rest/v1, /auth/v1, /storage/v1" 200
	}
}

api.postsub.io {
	import supabase_api
}
api.mytrove.app {
	import supabase_api
}
api.sendpov.xyz {
	import supabase_api
}
api.playsmuggler.com {
	import supabase_api
}