# GENERATED by scripts/render.py from apps.conf. Edit those, not this file.
# Caddy (arm64, official apt repo) terminates TLS (Let's Encrypt) for each app's API host and
# routes Supabase paths to THAT app's own services. Kong parity: REST + Storage refuse requests
# with no apikey/Authorization; Auth is exempt (OAuth redirects arrive without one). The check
# sits INSIDE each handle_path because Caddy orders handle_path before a site-level respond.

(supabase_app) {
	@nokey {
		not header apikey *
		not header Authorization *
	}
	handle_path /rest/v1/* {
		respond @nokey `{"message":"No API key found in request"}` 401
		reverse_proxy 127.0.0.1:5433{args[0]}
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:999{args[0]}
	}
	@storage_nokey {
		not header apikey *
		not header Authorization *
		not path /object/public/*
	}
	handle_path /storage/v1/* {
		respond @storage_nokey `{"message":"No API key found in request"}` 401
		reverse_proxy 127.0.0.1:500{args[0]}
	}
	handle {
		respond "supabase (cuphead) - use /rest/v1, /auth/v1, /storage/v1" 200
	}
}

